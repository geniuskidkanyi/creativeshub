<!DOCTYPE html>
<html data-controller="theme" data-theme="dark">
  <head>
    <title>SmartPay — Get Paid Smartly</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="The payment platform built for Gambian businesses and freelancers. Accept Wave, Visa, Afrimoney, QMoney, and APS.">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="SmartPay">
    <meta name="theme-color" content="#0d0f14" media="(prefers-color-scheme: dark)">
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)">
    <link rel="manifest" href="/manifest.json">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= csrf_meta_tags %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }

      :root,
      [data-theme="dark"] {
        --bg: #06080c;
        --bg-alt: #0b0e15;
        --bg-card: #0d1018;
        --bg-footer: #04060a;
        --text: #fff;
        --text-muted: rgba(255,255,255,0.45);
        --text-dim: rgba(255,255,255,0.55);
        --text-soft: rgba(255,255,255,0.35);
        --text-faint: rgba(255,255,255,0.2);
        --border: rgba(255,255,255,0.07);
        --border-light: rgba(255,255,255,0.06);
        --nav-bg: rgba(6,8,12,0.92);
        --nav-link: rgba(255,255,255,0.6);
        --primary: #c9a84c;
        --primary-dark: #b8943a;
        --primary-glow: rgba(201,168,76,0.15);
        --stats-text: rgba(255,255,255,0.4);
        --badge-bg: rgba(201,168,76,0.1);
        --badge-border: rgba(201,168,76,0.25);
        --card-hover-border: rgba(255,255,255,0.07);
        --gradient-glow: radial-gradient(ellipse, rgba(201,168,76,0.12) 0%, transparent 70%);
        --grid-color: rgba(201,168,76,0.04);
        --pricing-highlight-bg: linear-gradient(160deg, #1a150a 0%, #191309 100%);
        --cta-bg: linear-gradient(135deg, #1a150a 0%, #1d180c 50%, #1a150a 100%);
        --hero-bg: #06080c;
        --input-bg: rgba(255,255,255,0.06);
        --feature-grid-bg: rgba(255,255,255,0.06);
      }

      [data-theme="light"] {
        --bg: #fafafa;
        --bg-alt: #f0f1f3;
        --bg-card: #ffffff;
        --bg-footer: #f5f5f5;
        --text: #1a1a1a;
        --text-muted: rgba(0,0,0,0.5);
        --text-dim: rgba(0,0,0,0.6);
        --text-soft: rgba(0,0,0,0.4);
        --text-faint: rgb(34 34 34 / 71%);
        --border: rgba(0,0,0,0.08);
        --border-light: rgba(0,0,0,0.05);
        --nav-bg: rgba(250,250,250,0.92);
        --nav-link: rgba(0,0,0,0.6);
        --primary: #c9a84c;
        --primary-dark: #b8943a;
        --primary-glow: rgba(201,168,76,0.1);
        --stats-text: rgba(0,0,0,0.55);
        --badge-bg: rgba(201,168,76,0.08);
        --badge-border: rgba(201,168,76,0.3);
        --card-hover-border: rgba(0,0,0,0.12);
        --gradient-glow: radial-gradient(ellipse, rgba(201,168,76,0.08) 0%, transparent 70%);
        --grid-color: rgba(201,168,76,0.03);
        --pricing-highlight-bg: linear-gradient(160deg, #fdf8f0 0%, #faf3e5 100%);
        --cta-bg: linear-gradient(135deg, #fdf8f0 0%, #faf3e5 50%, #fdf8f0 100%);
        --hero-bg: #fafafa;
        --input-bg: rgba(0,0,0,0.04);
        --feature-grid-bg: rgba(0,0,0,0.05);
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-size: 15px;
        -webkit-font-smoothing: antialiased;
      }

      .logo-dark { display: none; }
      .logo-light { display: none; }
      [data-theme="dark"] .logo-dark { display: block; }
      [data-theme="light"] .logo-light { display: block; }
    </style>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <div data-controller="site-flash"
         data-site-flash-notice-value="<%= flash[:notice].presence %>"
         data-site-flash-alert-value="<%= flash[:alert].presence %>">
    </div>
    <%= yield %>
  </body>
</html>
