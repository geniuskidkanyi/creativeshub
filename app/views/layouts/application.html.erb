<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "CreativesHub" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="CreativesHub">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,300;1,9..144,400&family=DM+Sans:wght@300;400;500;600&family=Geist+Mono:wght@300;400;500&display=swap" rel="stylesheet">
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-background text-foreground" style="font-family: var(--font-body)">
    <% if user_signed_in? && current_account.present? %>
      <div class="flex h-screen overflow-hidden">
        <%= render "shared/sidebar" %>
        <main class="flex-1 overflow-y-auto scrollbar-hide">
          <%= yield %>
        </main>
      </div>
    <% else %>
      <main>
        <% if flash[:notice] %>
          <div class="fixed top-4 right-4 z-50 max-w-sm rounded-md bg-accent/20 border border-accent/30 px-4 py-3 text-sm text-foreground">
            <%= flash[:notice] %>
          </div>
        <% end %>
        <% if flash[:alert] %>
          <div class="fixed top-4 right-4 z-50 max-w-sm rounded-md bg-destructive/20 border border-destructive/30 px-4 py-3 text-sm text-foreground">
            <%= flash[:alert] %>
          </div>
        <% end %>
        <%= yield %>
      </main>
    <% end %>
  </body>
</html>
