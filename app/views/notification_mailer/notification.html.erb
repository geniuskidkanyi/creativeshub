<div style="font-family: -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif; max-width: 520px; margin: 0 auto; color: #1a1a1a;">
  <p style="font-size: 15px; color: #444;">Hi <%= @recipient.name %>,</p>

  <h1 style="font-size: 20px; margin: 12px 0 8px;"><%= @event.title %></h1>
  <p style="font-size: 15px; line-height: 1.55; color: #333;"><%= @event.message %></p>

  <p style="margin: 26px 0;">
    <a href="<%= @action_url %>" style="display: inline-block; background: #355bbd; color: #fff; text-decoration: none; font-weight: 600; font-size: 14px; padding: 12px 22px; border-radius: 8px;">
      View in SmartPay
    </a>
  </p>

  <p style="font-size: 12px; color: #888; border-top: 1px solid #eee; padding-top: 14px;">
    You're receiving this because you have a SmartPay account. Manage notifications in your dashboard.
  </p>
</div>
