<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <title><%= @invoice.invoice_number || "Invoice" %></title>
    <style>
      body { font-family: 'Helvetica', 'Arial', sans-serif; font-size: 12px; color: #1f2937; padding: 20px; }
      .header { display: flex; justify-content: space-between; margin-bottom: 30px; }
      .header h1 { font-size: 24px; margin: 0; color: #111827; }
      .invoice-label { font-size: 14px; color: #6b7280; }
      .section { margin-bottom: 20px; }
      .section-title { font-size: 11px; text-transform: uppercase; color: #6b7280; letter-spacing: 1px; margin-bottom: 4px; }
      .section-content { font-size: 12px; line-height: 1.6; }
      .meta { display: flex; gap: 30px; margin-bottom: 20px; }
      table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
      th { text-align: left; font-size: 10px; text-transform: uppercase; color: #6b7280; padding: 8px 0; border-bottom: 2px solid #e5e7eb; }
      td { padding: 8px 0; border-bottom: 1px solid #f3f4f6; }
      .text-right { text-align: right; }
      .totals { margin-left: auto; width: 220px; }
      .totals .row { display: flex; justify-content: space-between; padding: 4px 0; font-size: 12px; }
      .totals .total { font-weight: bold; font-size: 14px; border-top: 2px solid #e5e7eb; margin-top: 4px; padding-top: 8px; }
      .notes { margin-top: 30px; padding-top: 15px; border-top: 1px solid #e5e7eb; }
      .footer { margin-top: 40px; font-size: 10px; color: #9ca3af; text-align: center; }
    </style>
  </head>
  <body>
    <div class="header">
      <div>
        <h1><%= current_account.business_name %></h1>
        <% if current_account.address.present? %>
          <p class="section-content"><%= current_account.address %></p>
        <% end %>
        <% if current_account.tax_id.present? %>
          <p class="section-content">Tax ID: <%= current_account.tax_id %></p>
        <% end %>
      </div>
      <div class="text-right">
        <p class="invoice-label">INVOICE</p>
        <h2><%= @invoice.invoice_number || "Draft" %></h2>
      </div>
    </div>

    <div class="section">
      <p class="section-title">Bill To</p>
      <p class="section-content"><strong><%= @invoice.client.name %></strong></p>
      <% if @invoice.client.company.present? %>
        <p class="section-content"><%= @invoice.client.company %></p>
      <% end %>
      <p class="section-content"><%= @invoice.client.email %></p>
      <% if @invoice.client.address.present? %>
        <p class="section-content"><%= @invoice.client.address %></p>
      <% end %>
    </div>

    <div class="meta">
      <div>
        <p class="section-title">Issue Date</p>
        <p class="section-content"><%= @invoice.issue_date&.strftime("%B %d, %Y") || "—" %></p>
      </div>
      <div>
        <p class="section-title">Due Date</p>
        <p class="section-content"><%= @invoice.due_date&.strftime("%B %d, %Y") || "—" %></p>
      </div>
      <div>
        <p class="section-title">Status</p>
        <p class="section-content"><%= @invoice.status.humanize %></p>
      </div>
    </div>

    <table>
      <thead>
        <tr>
          <th>Description</th>
          <th class="text-right">Qty</th>
          <th class="text-right">Price</th>
          <th class="text-right">Amount</th>
        </tr>
      </thead>
      <tbody>
        <% @invoice.invoice_items.each do |item| %>
          <tr>
            <td><%= item.description %></td>
            <td class="text-right"><%= item.quantity %></td>
            <td class="text-right"><%= number_to_currency(item.unit_price, unit: "D") %></td>
            <td class="text-right"><%= number_to_currency(item.amount, unit: "D") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <div class="totals">
      <div class="row">
        <span>Subtotal</span>
        <span><%= number_to_currency(@invoice.subtotal || 0, unit: "D") %></span>
      </div>
      <% if @invoice.tax_rate.to_f > 0 %>
        <div class="row">
          <span>Tax (<%= @invoice.tax_rate %> %)</span>
          <span><%= number_to_currency(@invoice.tax_amount || 0, unit: "D") %></span>
        </div>
      <% end %>
      <div class="row total">
        <span>Total</span>
        <span><%= number_to_currency(@invoice.total_amount || 0, unit: "D") %></span>
      </div>
    </div>

    <% if @invoice.notes.present? %>
      <div class="notes">
        <p class="section-title">Notes</p>
        <p class="section-content"><%= @invoice.notes %></p>
      </div>
    <% end %>

    <div class="footer">
      <p>Thank you for your business! — Powered by CreativesHub</p>
    </div>
  </body>
</html>
