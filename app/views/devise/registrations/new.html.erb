<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;background:var(--bg);padding:0 16px;font-family:'Plus Jakarta Sans',system-ui,sans-serif">
  <div style="width:100%;max-width:420px">
    <div style="text-align:center;margin-bottom:32px">
      <%= image_tag "smart-pay-logo.png", alt: "SmartPay", class: "logo-dark", style: "height:32px;margin:0 auto 24px" %>
      <%= image_tag "smart-logo-light.png", alt: "SmartPay", class: "logo-light", style: "height:32px;margin:0 auto 24px" %>
      <h1 style="font-family:'Unbounded',sans-serif;font-size:24px;font-weight:700;color:var(--text);margin:0 0 8px">Create your account</h1>
      <p style="font-size:14px;color:var(--text-muted);margin:0">Start accepting payments in minutes</p>
    </div>

    <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:12px;padding:28px 24px">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div style="display:flex;flex-direction:column;gap:16px">
          <div>
            <label style="display:block;font-size:12px;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:6px">Your Name</label>
            <%= f.text_field :name, autofocus: true, style: "width:100%;height:44px;border-radius:8px;border:1px solid var(--border);background:var(--input-bg);color:var(--text);padding:0 12px;font-size:14px;outline:none;box-sizing:border-box;font-family:'Plus Jakarta Sans',sans-serif" %>
          </div>

          <div>
            <label style="display:block;font-size:12px;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:6px">Email</label>
            <%= f.email_field :email, autocomplete: "email", style: "width:100%;height:44px;border-radius:8px;border:1px solid var(--border);background:var(--input-bg);color:var(--text);padding:0 12px;font-size:14px;outline:none;box-sizing:border-box;font-family:'Plus Jakarta Sans',sans-serif" %>
          </div>

          <div>
            <label style="display:block;font-size:12px;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:6px">Business Name</label>
            <%= text_field_tag :business_name, nil, style: "width:100%;height:44px;border-radius:8px;border:1px solid var(--border);background:var(--input-bg);color:var(--text);padding:0 12px;font-size:14px;outline:none;box-sizing:border-box;font-family:'Plus Jakarta Sans',sans-serif" %>
          </div>

          <div>
            <label style="display:block;font-size:12px;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:6px">Password</label>
            <% if @minimum_password_length %>
              <span style="font-size:11px;color:var(--text-faint)">(<%= @minimum_password_length %> characters minimum)</span>
            <% end %>
            <%= f.password_field :password, autocomplete: "new-password", style: "width:100%;height:44px;border-radius:8px;border:1px solid var(--border);background:var(--input-bg);color:var(--text);padding:0 12px;font-size:14px;outline:none;box-sizing:border-box;font-family:'Plus Jakarta Sans',sans-serif;margin-top:4px" %>
          </div>

          <div>
            <label style="display:block;font-size:12px;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:6px">Confirm Password</label>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", style: "width:100%;height:44px;border-radius:8px;border:1px solid var(--border);background:var(--input-bg);color:var(--text);padding:0 12px;font-size:14px;outline:none;box-sizing:border-box;font-family:'Plus Jakarta Sans',sans-serif" %>
          </div>
        </div>

        <div style="margin-top:24px">
          <%= f.submit "Sign up", style: "width:100%;height:44px;background:#c9a84c;color:#0d0f14;border:none;border-radius:8px;font-size:14px;font-weight:600;cursor:pointer;font-family:'Plus Jakarta Sans',sans-serif" %>
        </div>
      <% end %>

      <div style="margin-top:16px;text-align:center;font-size:13px;color:var(--text-muted)">
        <%- if controller_name != 'sessions' %>
          <%= link_to "Log in", new_session_path(resource_name), style: "color:#c9a84c;text-decoration:none" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
