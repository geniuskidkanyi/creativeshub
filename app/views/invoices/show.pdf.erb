<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <title><%= @invoice.invoice_number || "Invoice" %></title>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        font-family: 'Hanken Grotesk', 'Helvetica', 'Arial', sans-serif;
        font-size: 14px;
        font-weight: 500;
        color: #1a1a1a;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
      .page {
        width: 794px;
        min-height: 1123px;
        position: relative;
        background: #fff;
      }
      .accent-bar {
        background: #355bbd;
        height: 6px;
        width: 100%;
      }
      .content { padding: 52px 0px 0; }

      .brand-icon {
        width: 28px; height: 28px; background: #141a29; border-radius: 4px;
        display: inline-block; vertical-align: middle; text-align: center; line-height: 28px;
        margin-right: 8px;
      }
      .brand-name {
        font-family: 'Bricolage Grotesque', Georgia, sans-serif; font-size: 22px; font-weight: 500;
        color: #141a29; letter-spacing: 0.02em; vertical-align: middle;
      }
      .sender-info {
        font-size: 13px; color: #444; font-weight: 500;
        font-family: 'Geist Mono', 'Courier New', monospace;
        letter-spacing: 0.04em;
        padding-top: 15px;
      }
      .sender-logo img { height: 70px; width: auto; vertical-align: middle; }
      .invoice-label {
        font-family: 'Geist Mono', 'Courier New', monospace;
        font-size: 12px; color: #555; letter-spacing: 0.12em; text-transform: uppercase;
      }
      .invoice-number {
        font-family: 'Bricolage Grotesque', Georgia, sans-serif; font-size: 28px; font-weight: 500;
        color: #141a29; line-height: 1;
      }
      .divider { height: 1px; background: #dde1ea; margin: 36px 0; }

      .meta-label {
        font-family: 'Geist Mono', 'Courier New', monospace;
        font-size: 11px; color: #555; letter-spacing: 0.14em; text-transform: uppercase;
      }
      .meta-value {
        font-size: 16px; color: #141a29;
      }
      .meta-value-mono {
        font-size: 16px; font-family: 'Geist Mono', 'Courier New', monospace; color: #141a29;
      }
      .amount-due {
        font-family: 'Bricolage Grotesque', Georgia, sans-serif; font-size: 34px; font-weight: 500;
        color: #355bbd; line-height: 1;
      }
      .status-pill {
        display: inline-block;
        font-size: 11px; font-family: 'Geist Mono', 'Courier New', monospace;
        letter-spacing: 0.1em; text-transform: uppercase;
        padding: 3px 8px; border-radius: 3px; margin-top: 6px;
      }
      .status-dot {
        display: inline-block; width: 5px; height: 5px; border-radius: 50%;
        margin-right: 4px; vertical-align: middle;
      }

      table { width: 100%; border-collapse: collapse; }
      table.header-table { margin-bottom: 48px; }
      table.header-table td { vertical-align: top; }
      table.header-table td.right { text-align: right; }

      table.meta-table { margin-bottom: 44px; }
      table.meta-table td { vertical-align: top; width: 33.33%; }
      table.meta-table td.spacer { padding-left: 40px; }

      table.items-table { margin-bottom: 8px; }
      table.items-table thead th {
        border-top: 1px solid #dde1ea; border-bottom: 1px solid #dde1ea;
        padding: 10px 0;
        font-family: 'Geist Mono', 'Courier New', monospace;
        font-size: 11px; color: #555; letter-spacing: 0.14em; text-transform: uppercase;
        font-weight: normal;
      }
      table.items-table thead th.desc { text-align: left; }
      table.items-table thead th.num { text-align: right; width: 80px; }
      table.items-table thead th.rate { text-align: right; width: 100px; }
      table.items-table thead th.amount { text-align: right; width: 100px; }

      table.items-table tbody td {
        padding: 14px 0;
        border-bottom: 1px solid #f5f3f0;
        vertical-align: middle;
      }
      table.items-table tbody tr:last-child td { border-bottom: none; }

      .item-desc { font-size: 16px; color: #141a29; font-weight: 500; }
      .item-mono { font-family: 'Geist Mono', 'Courier New', monospace; font-size: 14px; color: #444; font-weight: 500; }
      .item-mono-bold { font-family: 'Geist Mono', 'Courier New', monospace; font-size: 16px; color: #141a29; font-weight: 600; }

      table.totals-table { width: 240px; margin-left: auto; margin-bottom: 48px; }
      table.totals-table td { padding: 8px 0; }
      table.totals-table td.label {
        font-size: 14px; color: #444; font-family: 'Geist Mono', 'Courier New', monospace;
      }
      table.totals-table td.val {
        font-size: 14px; color: #333; font-family: 'Geist Mono', 'Courier New', monospace;
        text-align: right;
      }
      table.totals-table tr.border td { border-bottom: 1px solid #f0ede8; }
      table.totals-table tr.total td { padding: 12px 0 0; }
      table.totals-table tr.total td.label {
        font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase; color: #444;
      }
      table.totals-table tr.total td.val {
        font-family: 'Bricolage Grotesque', Georgia, sans-serif; font-size: 26px; font-weight: 500;
        color: #355bbd; text-align: right;
      }

      .notes-box {
        background: #f7f9fd; border: 1px solid #e2e7f2; border-radius: 6px;
        padding: 16px 20px; margin-bottom: 40px;
      }
      .notes-label {
        font-family: 'Geist Mono', 'Courier New', monospace;
        font-size: 11px; color: #555; letter-spacing: 0.14em; text-transform: uppercase;
        margin-bottom: 6px;
      }
      .notes-text { font-size: 14px; color: #333; line-height: 1.6; font-weight: 500; }

      .pay-link-box {
        background: #f7f9fd; border: 1px solid #e2e7f2; border-radius: 6px;
        padding: 14px 20px; margin-bottom: 40px; text-align: center;
      }
      .pay-link-label {
        font-family: 'Geist Mono', 'Courier New', monospace;
        font-size: 11px; color: #444; letter-spacing: 0.1em; text-transform: uppercase;
        margin-bottom: 6px;
      }
      .pay-link-url {
        font-size: 13px; color: #355bbd; font-family: 'Geist Mono', 'Courier New', monospace;
      }
      .pay-qr { margin: 10px auto 8px; }
      .pay-qr svg { background: #fff; }
      .pay-link-hint {
        font-size: 11px; color: #555; font-family: 'Geist Mono', 'Courier New', monospace;
        letter-spacing: 0.06em; margin-top: 6px;
      }

      .section-title {
        font-family: 'Geist Mono', 'Courier New', monospace;
        font-size: 11px; color: #555; letter-spacing: 0.14em; text-transform: uppercase;
      }

      .payment-section { border-top: 1px solid #dde1ea; padding-top: 28px; margin-bottom: 52px; }
      table.payment-table td { width: 33.33%; padding: 0; }
      table.payment-table td.label {
        font-family: 'Geist Mono', 'Courier New', monospace;
        font-size: 11px; color: #555; letter-spacing: 0.1em; text-transform: uppercase;
        padding-bottom: 4px;
      }
      table.payment-table td.val {
        font-family: 'Geist Mono', 'Courier New', monospace; font-size: 14px; color: #333; font-weight: 500;
      }

      .footer {
        position: absolute; bottom: 0; left: 0; right: 0;
        padding: 16px 56px; border-top: 1px solid #f0ede8;
      }
      table.footer-table { width: 100%; }
      table.footer-table td { vertical-align: middle; }
      table.footer-table td.left { font-family: 'Geist Mono', 'Courier New', monospace; font-size: 11px; color: #555; letter-spacing: 0.1em; }
      table.footer-table td.right { font-family: 'Geist Mono', 'Courier New', monospace; font-size: 11px; color: #555; letter-spacing: 0.1em; text-align: right; }
      table.footer-table td.center { text-align: center; }
      .footer-dot { display: inline-block; width: 4px; height: 4px; border-radius: 50%; background: #dde1ea; margin: 0 3px; vertical-align: middle; }
      .footer-dot.gold { background: #355bbd; }
    </style>
  </head>
  <body>
    <div class="page">
      <div class="accent-bar"></div>

      <div class="content">
        <% account = @invoice.account %>

        <table class="header-table">
          <tr>
            <td>
              <div>
                <%# Images inlined as base64: Active Storage URLs aren't
                    generatable here and wkhtmltopdf couldn't fetch them anyway. %>
                <%= image_tag(asset_data_uri("smart-pay-logo.png"), alt: "SmartPay", style: "height: 30px; width: auto; vertical-align: middle;") %>
                <% if @invoice.account.logo.attached? %>
                  <span class="sender-logo" style="margin-left: 12px; padding-left: 14px; border-left: 1px solid #dde1ea;">
                    <%= image_tag base64_logo(@invoice.account), alt: @invoice.account.business_name %>
                  </span>
                <% end %>
              </div>
              <p class="sender-info"><%= @invoice.account.business_name %></p>
              <% if @invoice.account.phone.present? || @invoice.account.website.present? %>
                <p class="sender-info"><%= [@invoice.account.phone, @invoice.account.website].compact.join(" · ") %></p>
              <% end %>
              <% if @invoice.account.address.present? %>
                <p class="sender-info"><%= @invoice.account.address %></p>
              <% end %>
            </td>
            <td class="right">
              <p class="invoice-label">Invoice</p>
              <p class="invoice-number"><%= @invoice.invoice_number || "Draft" %></p>
            </td>
          </tr>
        </table>

        <div class="divider"></div>

        <table class="meta-table">
          <tr>
            <td>
              <p class="meta-label">Bill To</p>
              <p class="meta-value" style="font-weight:600"><%= @invoice.client.name %></p>
              <% if @invoice.client.company.present? %>
                <p class="meta-value" style="color:#333;font-weight:400"><%= @invoice.client.company %></p>
              <% end %>
              <p class="meta-value-mono" style="color:#333"><%= @invoice.client.email %></p>
              <% if @invoice.client.address.present? %>
                <p class="meta-value" style="color:#333"><%= @invoice.client.address %></p>
              <% end %>
            </td>
            <td class="spacer">
              <p class="meta-label">Issue Date</p>
              <p class="meta-value-mono"><%= @invoice.issue_date&.strftime("%b %d, %Y") || "—" %></p>
              <p class="meta-label" style="margin-top:16px">Due Date</p>
              <p class="meta-value-mono"><%= @invoice.due_date&.strftime("%b %d, %Y") || "—" %></p>
            </td>
            <td class="spacer">
              <p class="meta-label">Amount Due</p>
              <p class="amount-due"><%= @invoice.currency_symbol %><%= number_with_precision(@invoice.total_amount || 0, precision: 0) %></p>
              <div class="status-pill" style="<%= status_pill_style(@invoice.status) %>">
                <span class="status-dot" style="background:currentColor"></span>
                <%= @invoice.status.humanize %>
              </div>
            </td>
          </tr>
        </table>

        <table class="items-table">
          <thead>
            <tr>
              <th class="desc">Description</th>
              <th class="num">Qty</th>
              <th class="rate">Rate</th>
              <th class="amount">Amount</th>
            </tr>
          </thead>
          <tbody>
            <% @invoice.invoice_items.each do |item| %>
              <tr>
                <td class="desc">
                  <p class="item-desc"><%= item.description %></p>
                  <% if item.details.present? %>
                    <p style="font-size:12px;color:#666;margin-top:2px"><%= simple_format(item.details, {}, wrapper_tag: "span") %></p>
                  <% end %>
                </td>
                <td class="num"><p class="item-mono"><%= item.quantity %></p></td>
                <td class="rate"><p class="item-mono"><%= @invoice.currency_symbol %><%= number_with_precision(item.unit_price, precision: 0) %></p></td>
                <td class="amount"><p class="item-mono-bold"><%= @invoice.currency_symbol %><%= number_with_precision(item.amount, precision: 0) %></p></td>
              </tr>
            <% end %>
          </tbody>
        </table>

        <table class="totals-table">
          <tr class="border">
            <td class="label">Subtotal</td>
            <td class="val"><%= @invoice.currency_symbol %><%= number_with_precision(@invoice.subtotal || 0, precision: 0) %></td>
          </tr>
          <% if @invoice.discount.to_f > 0 %>
            <tr class="border">
              <td class="label">Discount</td>
              <td class="val">−<%= @invoice.currency_symbol %><%= number_with_precision(@invoice.discount, precision: 0) %></td>
            </tr>
          <% end %>
          <% if @invoice.tax_rate.to_f > 0 %>
            <tr class="border">
              <td class="label">Tax (<%= @invoice.tax_rate %> %)</td>
              <td class="val"><%= @invoice.currency_symbol %><%= number_with_precision(@invoice.tax_amount || 0, precision: 0) %></td>
            </tr>
          <% end %>
          <tr class="total">
            <td class="label">Total Due</td>
            <td class="val"><%= @invoice.currency_symbol %><%= number_with_precision(@invoice.total_amount || 0, precision: 0) %></td>
          </tr>
          <% unless @invoice.base_currency? %>
            <tr class="border">
              <td class="label">Charged in GMD (rate <%= @invoice.fx_rate %>)</td>
              <td class="val">D<%= number_with_delimiter(number_with_precision(@invoice.gmd_total, precision: 0)) %></td>
            </tr>
          <% end %>
        </table>

        <% if @invoice.notes.present? %>
          <div class="notes-box">
            <p class="notes-label">Notes</p>
            <p class="notes-text"><%= @invoice.notes %></p>
          </div>
        <% end %>

        <% unless @invoice.paid? %>
          <div class="pay-link-box">
            <p class="pay-link-label">Pay Online</p>
            <div class="pay-qr"><%= raw invoice_qr_svg(@invoice) %></div>
            <p class="pay-link-url"><%= invoice_public_link(@invoice) %></p>
            <p class="pay-link-hint">Scan the code with your phone camera to view and pay this invoice.</p>
          </div>
        <% end %>

        <div class="payment-section">
          <p class="section-title" style="margin-bottom:14px">Payment Details</p>
          <table class="payment-table">
            <tr>
              <td>
                <p class="label">Invoice</p>
                <p class="val"><%= @invoice.invoice_number || "Draft" %></p>
              </td>
              <td>
                <p class="label">Status</p>
                <p class="val"><%= @invoice.status.humanize %></p>
              </td>
              <td>
                <p class="label">Currency</p>
                <p class="val"><%= @invoice.currency %></p>
              </td>
            </tr>
          </table>
        </div>
      </div>

      <div class="footer">
        <table class="footer-table">
          <tr>
            <td class="left">SMARTPAY · <%= @invoice.account.business_name&.upcase %></td>
            <td class="center">
              <a href="<%= Rails.configuration.x.public_host %>" style="color:#355bbd;text-decoration:none;letter-spacing:0.06em;">smartpay.gm</a>
            </td>
            <td class="right">Thank you for your business.</td>
          </tr>
        </table>
      </div>
    </div>
  </body>
</html>
