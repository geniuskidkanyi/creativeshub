<div class="px-6 py-6 max-w-2xl">
  <div class="mb-6">
    <%= link_to "← Dashboard", dashboard_path, class: "text-xs text-muted-foreground hover:text-foreground transition-colors" %>
    <h1 class="text-2xl text-foreground mt-3" style="font-family: var(--font-display)">Business Settings</h1>
  </div>

  <%= form_for @account, html: { multipart: true } do |f| %>
    <% if @account.errors.any? %>
      <div class="rounded-md bg-destructive/10 border border-destructive/30 p-4 mb-6">
        <ul class="list-disc pl-5 space-y-1 text-sm text-destructive-foreground">
          <% @account.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="bg-card border border-border rounded-lg p-5 mb-4">
      <h2 class="text-sm text-foreground font-medium mb-4">Logo</h2>
      <div class="flex items-start gap-6">
        <div class="shrink-0">
          <% if @account.logo.attached? %>
            <%= image_tag @account.logo.variant(resize_to_limit: [160, 80]), class: "h-16 rounded-md border border-border object-contain bg-muted/30" %>
          <% else %>
            <div class="h-16 w-40 rounded-md border border-border bg-muted/30 flex items-center justify-center">
              <svg class="w-6 h-6 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            </div>
          <% end %>
        </div>
        <div class="flex-1">
          <p class="text-xs text-muted-foreground mb-2">Upload your business logo. Will appear on invoices and PDFs. Recommended: rectangular logo, max 2MB.</p>
          <%= f.file_field :logo, accept: "image/png,image/jpeg,image/svg+xml", class: "block w-full text-sm text-foreground file:mr-3 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-medium file:bg-secondary file:text-secondary-foreground hover:file:bg-secondary/80 file:transition-colors" %>
          <% if @account.logo.attached? %>
            <div class="mt-2">
              <label class="inline-flex items-center gap-1.5 text-xs text-destructive hover:text-destructive/80 cursor-pointer">
                <%= check_box_tag "remove_logo", "1", false, class: "rounded border-border bg-input-background" %>
                Remove logo
              </label>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="bg-card border border-border rounded-lg p-5 mb-4">
      <h2 class="text-sm text-foreground font-medium mb-4">Business Information</h2>

      <div class="space-y-4">
        <div>
          <%= f.label :business_name, class: "block text-xs text-muted-foreground uppercase tracking-wider mb-1.5" %>
          <%= f.text_field :business_name, class: "w-full rounded-md border border-border bg-input-background text-foreground px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary" %>
        </div>

        <div>
          <%= f.label :address, class: "block text-xs text-muted-foreground uppercase tracking-wider mb-1.5" %>
          <%= f.text_area :address, rows: 3, class: "w-full rounded-md border border-border bg-input-background text-foreground px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary" %>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <%= f.label :phone, class: "block text-xs text-muted-foreground uppercase tracking-wider mb-1.5" %>
            <%= f.text_field :phone, class: "w-full rounded-md border border-border bg-input-background text-foreground px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary" %>
          </div>
          <div>
            <%= f.label :website, class: "block text-xs text-muted-foreground uppercase tracking-wider mb-1.5" %>
            <%= f.text_field :website, class: "w-full rounded-md border border-border bg-input-background text-foreground px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary" %>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <%= f.label :tax_id, "Tax ID", class: "block text-xs text-muted-foreground uppercase tracking-wider mb-1.5" %>
            <%= f.text_field :tax_id, class: "w-full rounded-md border border-border bg-input-background text-foreground px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary" %>
          </div>
          <div>
            <%= f.label :currency, class: "block text-xs text-muted-foreground uppercase tracking-wider mb-1.5" %>
            <%= f.select :currency, [ [ "GMD", "GMD" ], [ "USD", "USD" ], [ "EUR", "EUR" ] ], {}, class: "w-full rounded-md border border-border bg-input-background text-foreground px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary" %>
          </div>
        </div>
      </div>
    </div>

    <div class="bg-card border border-border rounded-lg p-5 mb-4">
      <h2 class="text-sm text-foreground font-medium mb-2">Payout Settings</h2>
      <p class="text-xs text-muted-foreground mb-4">Configure how you receive payments. Your account receives 98% of each payment; CreativesHub keeps 2%.</p>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= f.label :settlement_code, "Provider", class: "block text-xs text-muted-foreground uppercase tracking-wider mb-1.5" %>
          <%= f.select :settlement_code, [ [ "Afrimoney", "afrimoney" ], [ "Wave", "wave" ] ], { include_blank: "Select provider..." }, class: "w-full rounded-md border border-border bg-input-background text-foreground px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary" %>
        </div>
        <div>
          <%= f.label :settlement_account_number, "Account Number", class: "block text-xs text-muted-foreground uppercase tracking-wider mb-1.5" %>
          <%= f.text_field :settlement_account_number, placeholder: "e.g. 7012345", class: "w-full rounded-md border border-border bg-input-background text-foreground px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary" %>
        </div>
      </div>

      <% if @account.modempay_sub_account_id.present? %>
        <p class="mt-3 text-xs text-accent flex items-center gap-1">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
          Connected to ModemPay. Sub-account active.
        </p>
      <% end %>
    </div>

    <div class="flex gap-3">
      <%= f.submit "Save Changes", class: "flex-1 flex justify-center py-2.5 px-4 bg-primary text-primary-foreground rounded-md text-sm font-medium hover:brightness-110 transition-all" %>
      <%= link_to "Cancel", dashboard_path, class: "px-4 py-2.5 bg-secondary text-secondary-foreground rounded-md text-sm hover:bg-secondary/80 transition-colors" %>
    </div>
  <% end %>
</div>
