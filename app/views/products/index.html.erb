<div class="px-6 py-6">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl text-foreground mb-1" style="font-family: var(--font-display)">Products & Services</h1>
      <p class="text-sm text-muted-foreground"><%= pluralize(@pagy.count, "product") %></p>
    </div>
    <%= link_to new_product_path, class: "inline-flex items-center gap-2 px-4 py-2 bg-primary text-primary-foreground rounded-md text-sm font-medium hover:brightness-110 transition-all" do %>
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Add Product
    <% end %>
  </div>

  <%= render "shared/search_bar", url: products_path, placeholder: "Search products by name or description…", query: @q %>

  <% if @products.any? %>
    <div class="bg-card border border-border rounded-lg overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="border-b border-border">
              <th class="text-left px-5 py-3 text-xs text-muted-foreground font-medium uppercase tracking-wider">Name</th>
              <th class="text-left px-5 py-3 text-xs text-muted-foreground font-medium uppercase tracking-wider">Description</th>
              <th class="text-right px-5 py-3 text-xs text-muted-foreground font-medium uppercase tracking-wider">Price</th>
              <th class="text-right px-5 py-3 text-xs text-muted-foreground font-medium uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            <% @products.each do |product| %>
              <tr class="hover:bg-muted/30 transition-colors">
                <td class="px-5 py-3.5 text-sm text-foreground font-medium"><%= product.name %></td>
                <td class="px-5 py-3.5 text-sm text-muted-foreground"><%= product.description.presence || "—" %></td>
                <td class="px-5 py-3.5 text-sm text-foreground text-right font-medium">D<%= number_with_precision(product.unit_price, precision: 0) %></td>
                <td class="px-5 py-3.5 text-right">
                  <%= link_to "Edit", edit_product_path(product), class: "text-xs text-primary hover:text-primary/80 mr-3" %>
                  <%= link_to "Delete", product_path(product), data: { turbo_method: :delete, turbo_confirm: "Remove this product?" }, class: "text-xs text-muted-foreground hover:text-destructive" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <%= render "shared/pagination", pagy: @pagy %>
  <% else %>
    <div class="bg-card border border-border rounded-lg p-12 text-center">
      <% if @q.present? %>
        <p class="text-muted-foreground mb-4">No products match “<%= @q %>”.</p>
        <%= link_to "Clear search", products_path, class: "text-primary hover:text-primary/80 font-medium text-sm" %>
      <% else %>
        <p class="text-muted-foreground mb-4">No products yet. Add your services and products to quickly build invoices.</p>
        <%= link_to "Add your first product", new_product_path, class: "text-primary hover:text-primary/80 font-medium text-sm" %>
      <% end %>
    </div>
  <% end %>
</div>
