<!DOCTYPE html>
<html data-controller="theme" data-theme="dark">
  <head>
    <title><%= content_for(:title) || "SmartPay" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="SmartPay">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="SmartPay">
    <meta name="theme-color" content="#0d111b">
    <link rel="manifest" href="/manifest.json">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&family=Hanken+Grotesk:wght@400;500;600;700&family=Geist+Mono:wght@300;400;500&display=swap" rel="stylesheet">
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <style>
      [data-theme="light"] {
        --background: oklch(0.985 0.006 265);
        --foreground: oklch(0.22 0.03 265);
        --card: #ffffff;
        --card-foreground: oklch(0.22 0.03 265);
        --popover: #ffffff;
        --popover-foreground: oklch(0.22 0.03 265);
        --primary: oklch(0.5 0.16 265);
        --primary-foreground: #ffffff;
        --accent: oklch(0.6 0.13 25);
        --accent-foreground: #ffffff;
        --muted: oklch(0.96 0.012 265);
        --muted-foreground: oklch(0.5 0.02 265);
        --border: oklch(0.91 0.012 265);
        --input: transparent;
        --input-background: oklch(0.97 0.008 265);
        --ring: oklch(0.5 0.16 265);
        --secondary: oklch(0.96 0.012 265);
        --secondary-foreground: oklch(0.5 0.02 265);
        --sidebar: #ffffff;
        --sidebar-foreground: oklch(0.22 0.03 265);
        --sidebar-primary: oklch(0.5 0.16 265);
        --sidebar-primary-foreground: #ffffff;
        --sidebar-accent: color-mix(in oklch, oklch(0.5 0.16 265) 10%, transparent);
        --sidebar-accent-foreground: oklch(0.5 0.16 265);
        --sidebar-border: oklch(0.91 0.012 265);
        --sidebar-ring: oklch(0.5 0.16 265);
      }

      .logo-dark { display: none !important; }
      .logo-light { display: none !important; }
      [data-theme="dark"] .logo-dark { display: block !important; }
      [data-theme="light"] .logo-light { display: block !important; }
    </style>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-background text-foreground" style="font-family: var(--font-body)">
    <div data-controller="site-flash"
         data-site-flash-notice-value="<%= flash[:notice].presence %>"
         data-site-flash-alert-value="<%= flash[:alert].presence %>">
    </div>
    <% if user_signed_in? && current_account.present? %>
      <div data-controller="sidebar" class="flex h-screen overflow-hidden">
        <div data-sidebar-target="backdrop" class="hidden fixed inset-0 bg-black/60 z-40 lg:hidden" data-action="click->sidebar#close"></div>

        <%= render "shared/sidebar" %>

        <main class="flex-1 overflow-y-auto scrollbar-hide">
          <div class="lg:hidden sticky top-0 z-20 flex items-center justify-between px-4 py-3 bg-background/80 backdrop-blur border-b border-border">
            <button type="button" data-action="sidebar#open" class="p-1 -ml-1 text-foreground">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
            </button>
            <div class="flex items-center gap-2">
              <%= link_to root_path, class: "flex items-center gap-2.5" do %>
                <%= image_tag "smart-pay-logo.png", alt: "SmartPay Logo", class: "logo-light w-24" %>
                <%= image_tag "smart-logo-light.png", alt: "SmartPay Logo", class: "logo-dark w-24" %>
              <% end %>
            </div>
            <button data-action="theme#toggle" class="p-1.5 text-muted-foreground hover:text-foreground transition-colors">
              <svg data-theme-target="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            </button>
          </div>
          <%= yield %>
        </main>
      </div>
    <% else %>
      <main>
        <%= yield %>
      </main>
    <% end %>
  </body>
</html>
