<% if resource.errors.any? %>
  <div style="background:rgba(192,57,43,0.1);border:1px solid rgba(192,57,43,0.3);border-radius:8px;padding:12px 16px;margin-bottom:20px">
    <p style="font-size:13px;font-weight:600;color:#c0392b;margin:0 0 8px">
      <%= pluralize(resource.errors.count, "error") %> prohibited this from being saved:
    </p>
    <ul style="margin:0;padding-left:20px;display:flex;flex-direction:column;gap:4px">
      <% resource.errors.full_messages.each do |message| %>
        <li style="font-size:12px;color:#c0392b"><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
