<% content_for(:title) { "Payment QR" } %>
<div class="px-5 py-7 lg:px-9 lg:py-8 max-w-[720px]">
  <h1 class="text-[28px] text-foreground mb-1">Payment QR</h1>
  <p class="text-sm text-muted-foreground mb-6">Show this code to your customer — they scan it, enter the amount, and pay you through Modem Pay.</p>

  <div class="bg-card border border-border rounded-2xl p-6">
    <div class="flex flex-col items-center text-center">
      <div class="text-base font-bold text-foreground mb-1"><%= @account.business_name %></div>
      <p class="text-[13px] text-muted-foreground mb-5">Scan to pay · powered by SmartPay</p>

      <%= render "shared/payment_qr", account: @account %>
    </div>

    <div class="mt-6 pt-5 border-t border-border">
      <div class="flex gap-3 items-start text-[13px] text-muted-foreground">
        <span class="w-[34px] h-[34px] rounded-[10px] bg-primary/15 text-primary inline-flex items-center justify-center font-bold shrink-0">⛨</span>
        <p>This QR is protected with a rotating security code — it changes every minute and no code is ever reused, so screenshots or copies die within 60 seconds. Once a customer scans a live code it stays active for 5 minutes while they complete their payment. Keep this page open at your counter.</p>
      </div>
    </div>
  </div>
</div>
