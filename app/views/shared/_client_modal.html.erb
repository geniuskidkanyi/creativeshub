<div data-client-search-target="modal" class="hidden fixed inset-0 z-50 flex items-center justify-center">
  <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" data-action="click->client-search#closeModal"></div>
  <div class="relative bg-card border border-border rounded-lg w-full max-w-md p-6 mx-4 shadow-2xl">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-sm text-foreground font-medium">New Client</h3>
      <button type="button" data-action="client-search#closeModal" class="text-muted-foreground hover:text-foreground transition-colors">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <div data-client-search-target="modalErrors" class="hidden bg-destructive/10 border border-destructive/30 rounded-md p-3 mb-4">
      <ul class="list-disc pl-4 space-y-1"></ul>
    </div>

    <form data-client-search-target="newForm" data-action="submit->client-search#submitNewClient" action="<%= clients_path %>" method="post">
      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
      <div class="space-y-3">
        <div>
          <label class="block text-xs text-muted-foreground uppercase tracking-wider mb-1">Name *</label>
          <input type="text" name="client[name]" required class="w-full rounded-md border border-border bg-input-background text-foreground px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary">
        </div>
        <div>
          <label class="block text-xs text-muted-foreground uppercase tracking-wider mb-1">Email *</label>
          <input type="email" name="client[email]" required class="w-full rounded-md border border-border bg-input-background text-foreground px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary">
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs text-muted-foreground uppercase tracking-wider mb-1">Phone</label>
            <input type="text" name="client[phone]" class="w-full rounded-md border border-border bg-input-background text-foreground px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary">
          </div>
          <div>
            <label class="block text-xs text-muted-foreground uppercase tracking-wider mb-1">Company</label>
            <input type="text" name="client[company]" class="w-full rounded-md border border-border bg-input-background text-foreground px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary">
          </div>
        </div>
        <div>
          <label class="block text-xs text-muted-foreground uppercase tracking-wider mb-1">Address</label>
          <input type="text" name="client[address]" class="w-full rounded-md border border-border bg-input-background text-foreground px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary">
        </div>
      </div>
      <div class="flex gap-2 mt-5">
        <button type="button" data-action="client-search#closeModal" class="flex-1 px-3 py-2 bg-secondary text-secondary-foreground rounded-md text-sm hover:bg-secondary/80 transition-colors">Cancel</button>
        <button type="submit" class="flex-1 px-3 py-2 bg-primary text-primary-foreground rounded-md text-sm font-medium hover:brightness-110 transition-all">Create Client</button>
      </div>
    </form>
  </div>
</div>
