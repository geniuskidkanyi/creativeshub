<div class="px-6 py-6 max-w-2xl mx-auto lg:px-9 lg:py-8">
  <div class="mb-6">
    <%= link_to "← Clients", clients_path, class: "text-xs text-muted-foreground hover:text-foreground transition-colors" %>
    <h1 class="text-2xl text-foreground mt-3" style="font-family: var(--font-display)"><%= @client.persisted? ? "Edit Client" : "New Client" %></h1>
  </div>

  <div class="bg-card border border-border rounded-lg p-5">
    <%= form_for @client do |f| %>
      <% if @client.errors.any? %>
        <div class="rounded-md bg-destructive/10 border border-destructive/30 p-4 mb-6">
          <ul class="list-disc pl-5 space-y-1 text-sm text-destructive-foreground">
            <% @client.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="space-y-4">
        <div>
          <%= f.label :name, class: "block text-xs text-muted-foreground uppercase tracking-wider mb-1.5" %>
          <%= f.text_field :name, class: "w-full rounded-md border border-border bg-input-background text-foreground px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary" %>
        </div>
        <div>
          <%= f.label :email, class: "block text-xs text-muted-foreground uppercase tracking-wider mb-1.5" %>
          <%= f.email_field :email, class: "w-full rounded-md border border-border bg-input-background text-foreground px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary" %>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <%= f.label :phone, class: "block text-xs text-muted-foreground uppercase tracking-wider mb-1.5" %>
            <%= f.text_field :phone, class: "w-full rounded-md border border-border bg-input-background text-foreground px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary" %>
          </div>
          <div>
            <%= f.label :company, class: "block text-xs text-muted-foreground uppercase tracking-wider mb-1.5" %>
            <%= f.text_field :company, class: "w-full rounded-md border border-border bg-input-background text-foreground px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary" %>
          </div>
        </div>
        <div>
          <%= f.label :address, class: "block text-xs text-muted-foreground uppercase tracking-wider mb-1.5" %>
          <%= f.text_area :address, rows: 3, class: "w-full rounded-md border border-border bg-input-background text-foreground px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary" %>
        </div>
      </div>

      <div class="flex gap-3 mt-6">
        <%= f.submit @client.persisted? ? "Update Client" : "Add Client", class: "flex-1 inline-flex justify-center px-4 py-2.5 bg-primary text-primary-foreground rounded-md text-sm font-medium hover:brightness-110 transition-all" %>
        <%= link_to "Cancel", clients_path, class: "inline-flex justify-center px-4 py-2.5 bg-secondary text-secondary-foreground rounded-md text-sm hover:bg-secondary/80 transition-colors" %>
      </div>
    <% end %>
  </div>
</div>
