<div class="px-6 py-6 max-w-[1240px] mx-auto lg:px-9 lg:py-8">
  <div class="mb-6">
    <%= link_to "← Clients", clients_path, class: "text-xs text-muted-foreground hover:text-foreground transition-colors" %>
    <div class="flex items-center justify-between mt-3">
      <div>
        <h1 class="text-2xl text-foreground" style="font-family: var(--font-display)"><%= @client.name %></h1>
        <% if @client.company.present? %>
          <p class="text-sm text-muted-foreground"><%= @client.company %></p>
        <% end %>
      </div>
      <div class="flex items-center gap-2">
        <%= link_to "Edit", edit_client_path(@client), class: "px-3 py-2 bg-secondary text-secondary-foreground rounded-md text-sm hover:bg-secondary/80 transition-colors" %>
        <%= link_to "Delete", client_path(@client), data: { turbo_method: :delete, turbo_confirm: "Remove this client?" }, class: "px-3 py-2 bg-destructive/10 text-destructive rounded-md text-sm hover:bg-destructive/20 transition-colors" %>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="bg-card border border-border rounded-lg p-5">
      <h3 class="text-xs text-muted-foreground uppercase tracking-wider mb-4">Contact</h3>
      <div class="space-y-3">
        <div class="flex items-center gap-2.5 text-sm">
          <svg class="w-4 h-4 text-muted-foreground shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          <span class="text-foreground"><%= @client.email %></span>
        </div>
        <% if @client.phone.present? %>
          <div class="flex items-center gap-2.5 text-sm">
            <svg class="w-4 h-4 text-muted-foreground shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <span class="text-foreground"><%= @client.phone %></span>
          </div>
        <% end %>
        <% if @client.address.present? %>
          <div class="flex items-center gap-2.5 text-sm">
            <svg class="w-4 h-4 text-muted-foreground shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span class="text-foreground"><%= @client.address %></span>
          </div>
        <% end %>
      </div>
    </div>

    <div class="lg:col-span-2 bg-card border border-border rounded-lg">
      <div class="px-5 py-4 border-b border-border">
        <h3 class="text-sm text-foreground font-medium">Invoices</h3>
      </div>
      <div class="p-5">
        <% if @client.invoices.any? %>
          <div class="space-y-3">
            <% @client.invoices.ordered.each do |inv| %>
              <div class="flex items-center justify-between py-2 border-b border-border last:border-b-0">
                <div>
                  <%= link_to inv.invoice_number, invoice_path(inv), class: "text-sm text-foreground hover:text-primary transition-colors font-medium" %>
                  <p class="text-xs text-muted-foreground"><%= inv.issue_date&.strftime("%b %d, %Y") %></p>
                </div>
                <div class="text-right">
                  <p class="text-sm text-foreground font-medium"><%= inv.currency_symbol %><%= number_with_precision(inv.total_amount, precision: 0) %></p>
                  <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-xs <%= status_badge(inv.status) %>">
                    <span class="w-1.5 h-1.5 rounded-full <%= status_dot(inv.status) %>"></span>
                    <%= inv.status.humanize %>
                  </span>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-sm text-muted-foreground">No invoices for this client yet.</p>
        <% end %>
      </div>
    </div>
  </div>
</div>
