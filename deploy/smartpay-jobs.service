# SolidQueue worker for SmartPay — the process that actually runs background
# jobs (imports, emails, recurring invoices, notifications).
#
# This is a systemd *user* unit (managed with `systemctl --user`, no sudo),
# living at ~/.config/systemd/user/smartpay-jobs.service for the deploy user.
#
# ── One-time setup (as the deploy user) ─────────────────────────────────────
#   mkdir -p ~/.config/systemd/user
#   cp ~/smartpay/current/deploy/smartpay-jobs.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now smartpay-jobs
#   systemctl --user status smartpay-jobs           # want: active (running)
#
# ── Enable linger (one-time, needs sudo once) ───────────────────────────────
# Without this the user's services stop when the SSH session ends and never
# start at boot:
#   sudo loginctl enable-linger deploy
#
# No sudoers rule is needed — Capistrano restarts it with `systemctl --user`.

[Unit]
Description=SmartPay SolidQueue worker (bin/jobs)
After=network.target

[Service]
Type=simple

# Runs from the Capistrano `current` symlink so each restart picks up the
# newest release. Secrets come from the symlinked config/master.key,
# config/database.yml and .env (loaded by dotenv-rails at boot) — same as Puma.
WorkingDirectory=/home/deploy/smartpay/current
Environment=RAILS_ENV=production

# rbenv user install: the shim resolves Ruby from .ruby-version in the workdir.
ExecStart=/home/deploy/.rbenv/shims/bundle exec bin/jobs

Restart=always
RestartSec=5

# Let SolidQueue finish/return in-flight jobs cleanly on stop and deploy.
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
# User-service target (not multi-user.target).
WantedBy=default.target
