<div class="min-h-screen flex items-center justify-center bg-background px-4">
  <div class="w-full max-w-lg">
    <div class="text-center mb-8">
      <h1 class="text-2xl text-foreground" style="font-family: var(--font-display)">Create Your Account</h1>
      <p class="mt-2 text-sm text-muted-foreground">Set up your business details.</p>
    </div>

    <div class="bg-card border border-border rounded-lg p-6">
      <%= form_for @account do |f| %>
        <% if @account.errors.any? %>
          <div class="rounded-md bg-destructive/10 border border-destructive/30 p-4 mb-6">
            <ul class="list-disc pl-5 space-y-1 text-sm text-destructive-foreground">
              <% @account.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="space-y-4">
          <div>
            <%= f.label :business_name, class: "block text-xs text-muted-foreground uppercase tracking-wider mb-1.5" %>
            <%= f.text_field :business_name, class: "w-full rounded-md border border-border bg-input-background text-foreground px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary" %>
          </div>

          <div>
            <%= f.label :address, class: "block text-xs text-muted-foreground uppercase tracking-wider mb-1.5" %>
            <%= f.text_area :address, rows: 3, class: "w-full rounded-md border border-border bg-input-background text-foreground px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary" %>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <%= f.label :phone, class: "block text-xs text-muted-foreground uppercase tracking-wider mb-1.5" %>
              <%= f.text_field :phone, class: "w-full rounded-md border border-border bg-input-background text-foreground px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary" %>
            </div>
            <div>
              <%= f.label :website, class: "block text-xs text-muted-foreground uppercase tracking-wider mb-1.5" %>
              <%= f.text_field :website, class: "w-full rounded-md border border-border bg-input-background text-foreground px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary" %>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <%= f.label :tax_id, "Tax ID", class: "block text-xs text-muted-foreground uppercase tracking-wider mb-1.5" %>
              <%= f.text_field :tax_id, class: "w-full rounded-md border border-border bg-input-background text-foreground px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary" %>
            </div>
            <div>
              <%= f.label :currency, class: "block text-xs text-muted-foreground uppercase tracking-wider mb-1.5" %>
              <%= f.select :currency, [ [ "GMD", "GMD" ], [ "USD", "USD" ], [ "EUR", "EUR" ] ], {}, class: "w-full rounded-md border border-border bg-input-background text-foreground px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary" %>
            </div>
          </div>
        </div>

        <div class="mt-6">
          <%= f.submit "Create Account", class: "w-full flex justify-center py-2.5 px-4 bg-primary text-primary-foreground rounded-md text-sm font-medium hover:brightness-110 transition-all" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
