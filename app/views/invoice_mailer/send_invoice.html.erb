<div style="font-family: -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif; max-width: 560px; margin: 0 auto; color: #1a1a1a;">
  <div style="text-align: center; padding: 8px 0 20px;">
    <% if attachments["business-logo"] %>
      <%= image_tag attachments["business-logo"].url, alt: @account.business_name, style: "max-height:52px;max-width:240px;width:auto;height:auto" %>
    <% else %>
      <div style="font-family: 'Bricolage Grotesque', Georgia, sans-serif; font-size: 22px; font-weight: 700; color: #141a29;"><%= @account.business_name %></div>
    <% end %>
  </div>

  <div style="border: 1px solid #e5e7eb; border-radius: 12px; padding: 28px;">
    <h1 style="font-size: 20px; margin: 0 0 4px;">Invoice <%= @invoice.invoice_number %></h1>
    <p style="font-size: 14px; color: #555; margin: 0 0 18px;">from <%= @account.business_name %></p>

    <p style="font-size: 15px;">Dear <%= @client.name %>,</p>
    <p style="font-size: 15px; line-height: 1.55;">
      Please find your invoice for
      <strong><%= number_to_currency(@invoice.total_amount, unit: @invoice.currency_symbol) %></strong>
      attached as a PDF.
    </p>

    <table style="font-size: 14px; color: #333; margin: 16px 0;">
      <tr><td style="padding: 2px 16px 2px 0; color: #666;">Invoice #</td><td><%= @invoice.invoice_number %></td></tr>
      <tr><td style="padding: 2px 16px 2px 0; color: #666;">Issue date</td><td><%= @invoice.issue_date&.strftime("%B %d, %Y") %></td></tr>
      <tr><td style="padding: 2px 16px 2px 0; color: #666;">Due date</td><td><%= @invoice.due_date&.strftime("%B %d, %Y") || "On receipt" %></td></tr>
    </table>

    <p style="margin: 24px 0;">
      <a href="<%= Rails.configuration.x.public_host %>/inv/<%= @invoice.public_token %>"
         style="display: inline-block; background: #355bbd; color: #fff; text-decoration: none; font-weight: 600; font-size: 14px; padding: 12px 24px; border-radius: 8px;">
        View &amp; pay online
      </a>
    </p>

    <p style="font-size: 14px; color: #555;">Thank you for your business.</p>
    <p style="font-size: 14px; color: #333; margin-bottom: 0;"><%= @account.business_name %></p>
  </div>

  <p style="font-size: 11px; color: #9ca3af; text-align: center; margin-top: 16px;">
    <%= image_tag attachments["smartpay-logo.png"].url, alt: "SmartPay", height: 12, style: "height:12px;width:auto;vertical-align:middle;opacity:0.55" %>
    Sent with SmartPay · Get paid smartly
  </p>
</div>

<%# Open-tracking pixel — records when the client's mail app loads images. %>
<%= image_tag @open_url, alt: "", width: 1, height: 1, style: "display:none;width:1px;height:1px" %>
