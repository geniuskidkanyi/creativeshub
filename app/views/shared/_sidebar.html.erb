<aside data-sidebar-target="sidebar" class="hidden lg:flex lg:flex-col fixed lg:sticky top-0 left-0 z-50 lg:z-auto h-screen w-56 bg-sidebar border-r border-sidebar-border flex-col">
  <div class="px-5 pt-6 pb-4 flex items-center justify-between">
    <%= link_to root_path, class: "flex items-center gap-2.5 hidden lg:flex" do %>
      <%= image_tag "smart-pay-logo.png", alt: "SmartPay Logo", class: "logo-light w-24" %>
      <%= image_tag "smart-logo-light.png", alt: "SmartPay Logo", class: "logo-dark w-24" %>
      <% if current_account.logo.attached? %>
                  <span class="sender-logo" style="margin-left: 12px; padding-left: 14px; border-left: 1px solid #dde1ea;">
                    <%= image_tag base64_logo(current_account), alt: current_account.business_name %>
                  </span>
                <% end %>
    <% end %>
    <button type="button" data-action="sidebar#close" class="lg:hidden p-1 text-muted-foreground hover:text-sidebar-foreground transition-colors">
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>

  <nav class="flex-1 px-3 space-y-1">
    <%= link_to dashboard_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm transition-colors #{current_page?(dashboard_path) ? 'bg-sidebar-accent text-sidebar-accent-foreground font-medium' : 'text-sidebar-foreground/60 hover:text-sidebar-foreground hover:bg-sidebar-accent/50'}" do %>
      <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
      Dashboard
    <% end %>

    <%= link_to invoices_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm transition-colors #{current_page?(invoices_path) || controller_name == 'invoices' ? 'bg-sidebar-accent text-sidebar-accent-foreground font-medium' : 'text-sidebar-foreground/60 hover:text-sidebar-foreground hover:bg-sidebar-accent/50'}" do %>
      <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
      Invoices
    <% end %>

    <%= link_to recurring_invoices_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm transition-colors #{controller_name == 'recurring_invoices' ? 'bg-sidebar-accent text-sidebar-accent-foreground font-medium' : 'text-sidebar-foreground/60 hover:text-sidebar-foreground hover:bg-sidebar-accent/50'}" do %>
      <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
      Recurring
    <% end %>

    <%= link_to clients_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm transition-colors #{current_page?(clients_path) || controller_name == 'clients' ? 'bg-sidebar-accent text-sidebar-accent-foreground font-medium' : 'text-sidebar-foreground/60 hover:text-sidebar-foreground hover:bg-sidebar-accent/50'}" do %>
      <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      Clients
    <% end %>

    <%= link_to products_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm transition-colors #{current_page?(products_path) || controller_name == 'products' ? 'bg-sidebar-accent text-sidebar-accent-foreground font-medium' : 'text-sidebar-foreground/60 hover:text-sidebar-foreground hover:bg-sidebar-accent/50'}" do %>
      <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="3"/><line x1="8" y1="2" x2="8" y2="22"/><line x1="16" y1="2" x2="16" y2="22"/><line x1="2" y1="8" x2="22" y2="8"/><line x1="2" y1="16" x2="22" y2="16"/></svg>
      Products
    <% end %>

    <%= link_to imports_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm transition-colors #{controller_name == 'imports' ? 'bg-sidebar-accent text-sidebar-accent-foreground font-medium' : 'text-sidebar-foreground/60 hover:text-sidebar-foreground hover:bg-sidebar-accent/50'}" do %>
      <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
      Import data
    <% end %>

    <%= link_to qr_code_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm transition-colors #{controller_name == 'qr_codes' ? 'bg-sidebar-accent text-sidebar-accent-foreground font-medium' : 'text-sidebar-foreground/60 hover:text-sidebar-foreground hover:bg-sidebar-accent/50'}" do %>
      <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M14 14h3v3h-3z"/><path d="M18 18h3v3h-3z"/><path d="M14 21h1"/><path d="M21 14v1"/></svg>
      Payment QR
    <% end %>

    <%= link_to edit_account_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm transition-colors #{controller_name == 'accounts' ? 'bg-sidebar-accent text-sidebar-accent-foreground font-medium' : 'text-sidebar-foreground/60 hover:text-sidebar-foreground hover:bg-sidebar-accent/50'}" do %>
      <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
      Business Settings
    <% end %>

    <div class="mt-6 p-4 rounded-xl bg-primary/10 <%= controller_name == 'payouts' ? 'ring-1 ring-primary/40' : '' %>">
      <div class="text-[13px] font-bold text-sidebar-foreground mb-1">Need a payout?</div>
      <div class="text-[12.5px] text-muted-foreground mb-3">D<%= number_with_delimiter(number_with_precision(current_account.available_payout_balance, precision: 0)) %> available to cash out.</div>
      <%= link_to "Cash out", new_payout_path, class: "block w-full text-center py-2 rounded-lg bg-primary text-primary-foreground font-semibold text-[13px] hover:brightness-110 transition-all" %>
      <%= link_to "Payout history", payouts_path, class: "block text-center text-xs text-muted-foreground hover:text-primary mt-2 transition-colors" %>
    </div>
  </nav>

  <div class="px-3 pb-3 space-y-1">
    <%= link_to new_invoice_path, class: "flex items-center gap-3 px-3 py-2 mb-2 rounded-lg text-sm bg-primary text-primary-foreground hover:brightness-110 transition-all" do %>
      <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      New Invoice
    <% end %>

    <%= link_to new_client_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-sidebar-foreground/60 hover:text-sidebar-foreground hover:bg-sidebar-accent/50 transition-colors" do %>
      <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
      Add Client
    <% end %>
  </div>

  <div class="px-3 pb-5 mt-auto border-t border-sidebar-border relative" data-controller="dropdown">
    <button data-action="dropdown#toggle" class="w-full flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-sidebar-accent/50 transition-colors text-left">
      <div class="w-8 h-8 rounded-full bg-primary/20 flex items-center justify-center text-primary text-xs font-medium shrink-0">
        <%= current_user.name.first.upcase %>
      </div>
      <div class="flex-1 min-w-0">
        <p class="text-sm text-sidebar-foreground truncate"><%= current_user.name %></p>
        <p class="text-xs text-muted-foreground truncate"><%= current_account.business_name %></p>
      </div>
      <svg class="w-4 h-4 text-muted-foreground shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
    </button>

    <div data-dropdown-target="menu" class="hidden absolute top-full lg:top-auto lg:bottom-full left-3 right-3 mt-1 lg:mt-0 lg:mb-1 bg-popover border border-border rounded-lg shadow-lg py-1 z-50">
      <%= link_to edit_user_registration_path, class: "flex items-center gap-2.5 px-3 py-2 text-sm text-foreground hover:bg-muted/50 transition-colors" do %>
        <svg class="w-4 h-4 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        Edit Profile
      <% end %>
      <%= link_to edit_account_path, class: "flex items-center gap-2.5 px-3 py-2 text-sm text-foreground hover:bg-muted/50 transition-colors" do %>
        <svg class="w-4 h-4 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
        Business Settings
      <% end %>
      <button data-action="theme#toggle" class="w-full flex items-center gap-2.5 px-3 py-2 text-sm text-foreground hover:bg-muted/50 transition-colors">
        <svg data-theme-target="icon" class="w-4 h-4 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <span data-theme-target="label">Toggle Theme</span>
      </button>
      <div class="mx-2 my-1 border-t border-border"></div>
      <%= button_to destroy_user_session_path, method: :delete, class: "w-full flex items-center gap-2.5 px-3 py-2 text-sm text-destructive hover:bg-muted/50 transition-colors" do %>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        Sign Out
      <% end %>
    </div>
  </div>
</aside>
