<%
label_style = "display:flex;flex-direction:column;gap:7px;font-size:13px;font-weight:600;color:var(--text)"
input_style = "padding:13px 15px;border:1px solid var(--border);border-radius:11px;background:var(--bg-card);color:var(--text);font-size:15px;font-family:'Hanken Grotesk',sans-serif;width:100%;box-sizing:border-box"
%>
<div class="grid lg:grid-cols-2" style="min-height:100vh;background:var(--bg);font-family:'Hanken Grotesk',system-ui,sans-serif;animation:spAuthIn .4s ease both">
  <style>@keyframes spAuthIn { from { opacity:0; transform:translateY(10px) } to { opacity:1; transform:none } }</style>

  <div style="display:flex;align-items:center;justify-content:center;padding:40px">
    <div style="width:100%;max-width:380px">
      <%= link_to root_path do %>
        <%= image_tag "smart-pay-logo.png", alt: "SmartPay", class: "logo-dark", style: "height:40px;margin-bottom:28px" %>
        <%= image_tag "smart-logo-light.png", alt: "SmartPay", class: "logo-light", style: "height:40px;margin-bottom:28px" %>
      <% end %>
      <h1 style="font-family:'Bricolage Grotesque',sans-serif;font-weight:700;font-size:32px;letter-spacing:-.02em;color:var(--text);margin-bottom:8px">Welcome back</h1>
      <p style="color:var(--text-muted);font-size:15px;margin-bottom:30px">Sign in to your SmartPay dashboard.</p>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <div style="display:flex;flex-direction:column;gap:16px">
          <label style="<%= label_style %>">Email
            <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "you@business.gm", style: input_style %>
          </label>
          <label style="<%= label_style %>">Password
            <%= f.password_field :password, autocomplete: "current-password", placeholder: "••••••••", style: input_style %>
          </label>
          <% if devise_mapping.rememberable? %>
            <div style="display:flex;align-items:center;gap:8px">
              <%= f.check_box :remember_me, style: "accent-color:var(--primary)" %>
              <label style="font-size:13px;color:var(--text-muted)">Remember me</label>
            </div>
          <% end %>
          <%= f.submit "Sign in", style: "padding:14px;border:none;border-radius:11px;background:var(--primary);color:var(--primary-ink);font-size:15px;font-weight:600;cursor:pointer;margin-top:4px;font-family:'Hanken Grotesk',sans-serif" %>
        </div>
      <% end %>

      <div style="display:flex;align-items:center;gap:12px;margin:22px 0;color:var(--text-muted);font-size:13px">
        <span style="flex:1;height:1px;background:var(--border)"></span>or<span style="flex:1;height:1px;background:var(--border)"></span>
      </div>

      <p style="text-align:center;font-size:14px;color:var(--text-muted)">
        Don't have an account?
        <%- if devise_mapping.registerable? %>
          <%= link_to "Sign up", new_registration_path(resource_name), style: "color:var(--primary);font-weight:600;text-decoration:none;font-size:14px" %>
        <% end %>
      </p>
      <%- if devise_mapping.recoverable? %>
        <p style="text-align:center;font-size:13px;margin-top:10px">
          <%= link_to "Forgot your password?", new_password_path(resource_name), style: "color:var(--text-muted);text-decoration:none" %>
        </p>
      <% end %>
    </div>
  </div>

  <%= render "devise/shared/auth_panel" %>
</div>
