<aside class="w-56 h-screen sticky top-0 bg-sidebar border-r border-sidebar-border flex flex-col">
  <div class="px-5 pt-6 pb-4">
    <div class="flex items-center gap-2.5">
      <div class="w-7 h-7 rounded-md bg-primary flex items-center justify-center">
        <svg class="w-4 h-4 text-primary-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
          <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
        </svg>
      </div>
      <span class="text-lg text-sidebar-foreground tracking-tight" style="font-family: var(--font-display)">CreativesHub</span>
    </div>
  </div>

  <nav class="flex-1 px-3 space-y-1">
    <%= link_to dashboard_path, class: "flex items-center gap-3 px-3 py-2 rounded-md text-sm transition-colors #{current_page?(dashboard_path) ? 'bg-sidebar-accent text-sidebar-foreground' : 'text-sidebar-foreground/60 hover:text-sidebar-foreground hover:bg-sidebar-accent/50'}" do %>
      <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
      Dashboard
    <% end %>

    <%= link_to invoices_path, class: "flex items-center gap-3 px-3 py-2 rounded-md text-sm transition-colors #{current_page?(invoices_path) || controller_name == 'invoices' ? 'bg-sidebar-accent text-sidebar-foreground' : 'text-sidebar-foreground/60 hover:text-sidebar-foreground hover:bg-sidebar-accent/50'}" do %>
      <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
      Invoices
    <% end %>

    <%= link_to clients_path, class: "flex items-center gap-3 px-3 py-2 rounded-md text-sm transition-colors #{current_page?(clients_path) || controller_name == 'clients' ? 'bg-sidebar-accent text-sidebar-foreground' : 'text-sidebar-foreground/60 hover:text-sidebar-foreground hover:bg-sidebar-accent/50'}" do %>
      <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      Clients
    <% end %>
  </nav>

  <div class="px-3 pb-3 space-y-1">
    <%= link_to new_invoice_path, class: "flex items-center gap-3 px-3 py-2 mb-2 rounded-md text-sm bg-primary text-primary-foreground hover:brightness-110 transition-all" do %>
      <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      New Invoice
    <% end %>

    <%= link_to new_client_path, class: "flex items-center gap-3 px-3 py-2 rounded-md text-sm text-sidebar-foreground/60 hover:text-sidebar-foreground hover:bg-sidebar-accent/50 transition-colors" do %>
      <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
      Add Client
    <% end %>
  </div>

  <div class="px-3 pb-5 mt-auto border-t border-sidebar-border">
    <div class="flex items-center gap-3 px-3 py-3">
      <div class="w-8 h-8 rounded-full bg-primary/20 flex items-center justify-center text-primary text-xs font-medium">
        <%= current_user.name.first.upcase %>
      </div>
      <div class="flex-1 min-w-0">
        <p class="text-sm text-sidebar-foreground truncate"><%= current_user.name %></p>
        <p class="text-xs text-muted-foreground truncate"><%= current_account.business_name %></p>
      </div>
      <%= button_to destroy_user_session_path, method: :delete, class: "text-muted-foreground hover:text-sidebar-foreground transition-colors", form_class: "flex" do %>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
      <% end %>
    </div>
  </div>
</aside>
