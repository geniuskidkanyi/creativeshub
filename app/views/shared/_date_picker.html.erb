<div data-controller="date-picker"
     data-date-picker-date-value="<%= value %>"
     class="relative">
  <%= hidden_field_tag name, value, data: { date_picker_target: "hidden" } %>
  <div class="relative">
    <input type="text"
           data-date-picker-target="input"
           data-action="focus->date-picker#focusInput click->date-picker#toggle"
           value="<%= value.present? ? Date.parse(value).strftime("%b %d, %Y") : "" %>"
           placeholder="<%= placeholder %>"
           readonly
           autocomplete="off"
           class="<%= input_class %> pr-8 cursor-pointer">
    <button type="button" data-action="click->date-picker#toggle" class="absolute right-2 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-foreground">
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
    </button>
  </div>
  <div data-date-picker-target="calendar"
       class="hidden absolute z-20 mt-1 bg-popover border border-border rounded-md shadow-lg w-64 left-0">
  </div>
</div>
