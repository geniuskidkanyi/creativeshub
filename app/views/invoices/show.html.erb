<div class="px-6 py-6 max-w-[1240px] mx-auto">
  <div class="mb-6">
    <%= link_to "← Invoices", invoices_path, class: "text-xs text-muted-foreground hover:text-foreground transition-colors" %>
    <div class="flex items-center justify-between mt-3">
      <div>
        <div class="flex items-center gap-3">
          <h1 class="text-2xl text-foreground" style="font-family: var(--font-display)"><%= @invoice.invoice_number || "Draft Invoice" %></h1>
          <% shown_status = @invoice.overdue? ? "overdue" : @invoice.status %>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded text-xs font-medium <%= status_badge(shown_status) %>">
            <span class="w-1.5 h-1.5 rounded-full <%= status_dot(shown_status) %>"></span>
            <%= shown_status.humanize %>
          </span>
        </div>
        <p class="text-sm text-muted-foreground mt-1"><%= @invoice.client.name %></p>
        <% if @invoice.paid? && @invoice.payment_method.present? %>
          <p class="text-xs text-primary mt-0.5">Paid via <%= @invoice.payment_method.humanize %><%= " on #{@invoice.paid_date.to_date.to_fs(:long)}" if @invoice.paid_date %></p>
        <% end %>
        <% if @invoice.emailed? %>
          <p class="text-xs text-muted-foreground mt-0.5">
            <svg class="inline w-3.5 h-3.5 -mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/></svg>
            Emailed <%= @invoice.email_sent_at.to_date.to_fs(:long) %>
            <% if @invoice.email_opened? %>
              · <span class="text-primary font-medium">Opened<%= " #{@invoice.email_opens}×" if @invoice.email_opens > 1 %></span> <%= time_ago_in_words(@invoice.email_opened_at) %> ago
            <% else %>
              · <span class="text-muted-foreground">not opened yet</span>
            <% end %>
          </p>
        <% end %>
      </div>
      <div class="flex items-center gap-2" data-controller="modal">
        <%= link_to invoice_path(@invoice, format: :pdf), class: "inline-flex items-center gap-1.5 px-3 py-2 bg-secondary text-secondary-foreground rounded-md text-sm hover:bg-secondary/80 transition-colors" do %>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          PDF
        <% end %>
        <button type="button"
                data-controller="clipboard"
                data-clipboard-text-value="<%= public_invoice_url(@invoice.public_token) %>"
                data-action="clipboard#copy"
                class="inline-flex items-center gap-1.5 px-3 py-2 bg-secondary text-secondary-foreground rounded-md text-sm hover:bg-secondary/80 transition-colors">
          <span data-clipboard-target="icon">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          </span>
          <span data-clipboard-target="label">Copy Link</span>
        </button>
        <% if @invoice.client.emailable? %>
          <%= button_to @invoice.emailed? ? "Resend email" : "Send email", resend_email_invoice_path(@invoice), method: :post,
                class: "inline-flex items-center gap-1.5 px-3 py-2 bg-secondary text-secondary-foreground rounded-md text-sm hover:bg-secondary/80 transition-colors cursor-pointer" %>
        <% end %>

        <% if @invoice.paid? %>
          <% if @invoice.payments.succeeded.none? %>
            <%# Only a manual mark-as-paid can be reversed; real online payments can't. %>
            <%= button_to "Mark as unpaid", mark_unpaid_invoice_path(@invoice), method: :post,
                  form: { data: { turbo_confirm: "Mark this invoice as unpaid?" } },
                  class: "inline-flex items-center gap-1.5 px-3 py-2 bg-secondary text-secondary-foreground rounded-md text-sm hover:bg-secondary/80 transition-colors cursor-pointer" %>
          <% end %>
        <% else %>
          <%= link_to "Edit", edit_invoice_path(@invoice), class: "inline-flex items-center gap-1.5 px-3 py-2 bg-secondary text-secondary-foreground rounded-md text-sm hover:bg-secondary/80 transition-colors" %>
          <% if @invoice.draft? %>
            <%= link_to "Mark as Sent", send_invoice_invoice_path(@invoice), data: { turbo_method: :post }, class: "inline-flex items-center gap-1.5 px-3 py-2 bg-blue-600 text-white rounded-md text-sm hover:bg-blue-700 transition-colors" %>
          <% end %>
          <button type="button" data-action="modal#open" class="inline-flex items-center gap-1.5 px-3 py-2 bg-secondary text-secondary-foreground rounded-md text-sm hover:bg-secondary/80 transition-colors">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            Mark as paid
          </button>
          <%= link_to "Accept Payment", pay_invoice_path(@invoice), class: "inline-flex items-center gap-1.5 px-3 py-2 bg-primary text-primary-foreground rounded-md text-sm hover:brightness-110 transition-all" %>
        <% end %>

        <%# Off-platform payment capture (cash, bank transfer, …). %>
        <div data-modal-target="panel" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4" data-action="click->modal#closeBackground">
          <div class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>
          <div class="relative bg-card border border-border rounded-lg w-full max-w-sm p-6 shadow-2xl">
            <h3 class="text-sm text-foreground font-medium mb-1">Mark as paid</h3>
            <p class="text-xs text-muted-foreground mb-4">Record a payment made outside SmartPay. This marks the invoice paid but doesn't add to your payout balance — the money isn't in your SmartPay wallet.</p>
            <%= form_with url: mark_paid_invoice_path(@invoice), method: :post do %>
              <label class="block text-xs text-muted-foreground uppercase tracking-wider mb-1.5">Payment method</label>
              <select name="invoice[payment_method]" class="w-full rounded-md border border-border bg-input-background text-foreground px-3 py-2 text-sm mb-3">
                <% [ "Cash", "Bank transfer", "Mobile money", "Cheque", "Other" ].each do |method| %>
                  <option value="<%= method %>"><%= method %></option>
                <% end %>
              </select>
              <label class="block text-xs text-muted-foreground uppercase tracking-wider mb-1.5">Payment date</label>
              <input type="date" name="invoice[paid_date]" value="<%= Date.current %>" max="<%= Date.current %>"
                     class="w-full rounded-md border border-border bg-input-background text-foreground px-3 py-2 text-sm mb-5">
              <div class="flex gap-2">
                <button type="button" data-action="modal#close" class="flex-1 px-3 py-2 rounded-md bg-secondary text-secondary-foreground text-sm">Cancel</button>
                <button type="submit" class="flex-1 px-3 py-2 rounded-md bg-primary text-primary-foreground text-sm font-medium cursor-pointer">Mark as paid</button>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="bg-card border border-border rounded-lg p-6">
    <div class="grid grid-cols-2 gap-8 mb-8">
      <div>
        <p class="text-xs text-muted-foreground uppercase tracking-wider mb-2">From</p>
        <% if current_account.logo.attached? %>
          <%= image_tag current_account.logo.variant(resize_to_limit: [200, 80]), class: "h-10 mb-2 object-contain" %>
        <% end %>
        <p class="text-sm text-foreground font-medium"><%= current_account.business_name %></p>
        <% if current_account.address.present? %>
          <p class="text-sm text-muted-foreground"><%= current_account.address %></p>
        <% end %>
        <% if current_account.phone.present? %>
          <p class="text-sm text-muted-foreground"><%= current_account.phone %></p>
        <% end %>
        <% if current_account.tax_id.present? %>
          <p class="text-xs text-muted-foreground mt-1">Tax ID: <%= current_account.tax_id %></p>
        <% end %>
      </div>
      <div>
        <p class="text-xs text-muted-foreground uppercase tracking-wider mb-2">Bill To</p>
        <p class="text-sm text-foreground font-medium"><%= @invoice.client.name %></p>
        <% if @invoice.client.company.present? %>
          <p class="text-sm text-muted-foreground"><%= @invoice.client.company %></p>
        <% end %>
        <p class="text-sm text-muted-foreground"><%= @invoice.client.email %></p>
      </div>
    </div>

    <div class="flex gap-8 mb-8">
      <div>
        <p class="text-xs text-muted-foreground uppercase">Invoice #</p>
        <p class="text-sm text-foreground font-medium"><%= @invoice.invoice_number || "—" %></p>
      </div>
      <div>
        <p class="text-xs text-muted-foreground uppercase">Issue Date</p>
        <p class="text-sm text-foreground font-medium"><%= @invoice.issue_date&.strftime("%b %d, %Y") || "—" %></p>
      </div>
      <div>
        <p class="text-xs text-muted-foreground uppercase">Due Date</p>
        <p class="text-sm text-foreground font-medium"><%= @invoice.due_date&.strftime("%b %d, %Y") || "—" %></p>
      </div>
    </div>

    <div class="mb-6">
      <table class="w-full">
        <thead>
          <tr class="border-b border-border">
            <th class="text-left py-3 text-xs text-muted-foreground font-medium uppercase tracking-wider">Description</th>
            <th class="text-right py-3 text-xs text-muted-foreground font-medium uppercase tracking-wider">Qty</th>
            <th class="text-right py-3 text-xs text-muted-foreground font-medium uppercase tracking-wider">Price</th>
            <th class="text-right py-3 text-xs text-muted-foreground font-medium uppercase tracking-wider">Amount</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          <% @invoice.invoice_items.each do |item| %>
            <tr>
              <td class="py-3 text-sm text-foreground">
                <%= item.description %>
                <% if item.details.present? %>
                  <span class="block text-xs text-muted-foreground mt-0.5"><%= simple_format(item.details, {}, wrapper_tag: "span") %></span>
                <% end %>
              </td>
              <td class="py-3 text-sm text-foreground text-right"><%= item.quantity %></td>
              <td class="py-3 text-sm text-foreground text-right"><%= @invoice.currency_symbol %><%= number_with_precision(item.unit_price, precision: 0) %></td>
              <td class="py-3 text-sm text-foreground text-right font-medium"><%= @invoice.currency_symbol %><%= number_with_precision(item.amount, precision: 0) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="flex justify-end border-t border-border pt-4">
      <div class="w-64 space-y-2">
        <div class="flex justify-between text-sm text-muted-foreground">
          <span>Subtotal</span>
          <span class="text-foreground"><%= @invoice.currency_symbol %><%= number_with_precision(@invoice.subtotal || 0, precision: 0) %></span>
        </div>
        <% if @invoice.tax_rate.to_f > 0 %>
          <div class="flex justify-between text-sm text-muted-foreground">
            <span>Tax (<%= @invoice.tax_rate %> %)</span>
            <span class="text-foreground"><%= @invoice.currency_symbol %><%= number_with_precision(@invoice.tax_amount || 0, precision: 0) %></span>
          </div>
        <% end %>
        <div class="flex justify-between text-base font-medium border-t border-border pt-2">
          <span class="text-foreground">Total</span>
          <span class="text-primary"><%= @invoice.currency_symbol %><%= number_with_precision(@invoice.total_amount || 0, precision: 0) %></span>
        </div>
        <% unless @invoice.base_currency? %>
          <div class="flex justify-between text-xs text-muted-foreground border-t border-border pt-2">
            <span>Charged in GMD (rate <%= @invoice.fx_rate %>)</span>
            <span>D<%= number_with_delimiter(number_with_precision(@invoice.gmd_total, precision: 0)) %></span>
          </div>
        <% end %>
      </div>
    </div>

    <% if @invoice.notes.present? %>
      <div class="mt-6 pt-4 border-t border-border">
        <p class="text-xs text-muted-foreground uppercase tracking-wider mb-2">Notes</p>
        <p class="text-sm text-foreground"><%= @invoice.notes %></p>
      </div>
    <% end %>
  </div>

  <% unless @invoice.paid? %>
    <div class="bg-card border border-border rounded-lg p-5 mt-4 flex items-center gap-5">
      <div class="bg-white rounded-xl p-2.5 shrink-0">
        <%= raw invoice_qr_svg(@invoice, module_size: 3) %>
      </div>
      <div>
        <h3 class="text-sm text-foreground font-medium">Scan to pay</h3>
        <p class="text-xs text-muted-foreground mt-1">Your customer can scan this code with their phone to open and pay this invoice — the same link as Copy Link.</p>
      </div>
    </div>
  <% end %>

  <% if @invoice.payments.succeeded.any? %>
    <div class="bg-card border border-border rounded-lg p-5 mt-4">
      <h3 class="text-sm text-foreground font-medium mb-3">Payment History</h3>
      <% @invoice.payments.succeeded.each do |payment| %>
        <div class="flex items-center justify-between py-2 border-b border-border last:border-b-0">
          <div>
            <p class="text-sm text-foreground font-medium">D<%= number_with_precision(payment.amount, precision: 0) %></p>
            <p class="text-xs text-muted-foreground"><%= payment.payment_method.humanize %> — <%= payment.paid_at&.strftime("%b %d, %Y %H:%M") %></p>
          </div>
          <span class="text-xs text-accent bg-accent/10 px-2 py-0.5 rounded">Succeeded</span>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
