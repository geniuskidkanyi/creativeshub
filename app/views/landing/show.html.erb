<%# ─── Shared style helpers ─── %>
<%
display = "'Bricolage Grotesque', sans-serif"
body_font = "'Hanken Grotesk', system-ui, sans-serif"
mono = "'Geist Mono', monospace"
%>

<style>
  @keyframes spIn { from { opacity:0; transform:translateY(10px) } to { opacity:1; transform:none } }
  @keyframes spGrow { from { transform:scaleY(0) } to { transform:scaleY(1) } }

  .sp-hero { max-width:1180px; margin:0 auto; padding:158px 40px 70px; display:grid; grid-template-columns:1.05fr .95fr; gap:56px; align-items:center; }
  .sp-strip-inner { max-width:1180px; margin:0 auto; padding:26px 40px; display:flex; align-items:center; gap:34px; flex-wrap:wrap; }
  .sp-section { max-width:1180px; margin:0 auto; padding:84px 40px; }
  .sp-grid-3 { display:grid; grid-template-columns:repeat(3,1fr); gap:18px; }
  .sp-fee-row { display:grid; grid-template-columns:1.4fr 1fr 1fr 1fr; padding:15px 24px; align-items:center; }
  .sp-badge { width:34px; height:34px; border-radius:10px; background:rgba(var(--primary-rgb),0.14); color:var(--primary); display:inline-flex; align-items:center; justify-content:center; font-weight:700; font-size:14px; flex-shrink:0; }
  .sp-btn-primary { display:inline-block; padding:15px 28px; border:none; border-radius:13px; background:var(--primary); color:var(--primary-ink); font-size:16px; font-weight:600; cursor:pointer; text-decoration:none; }
  .sp-btn-ghost { display:inline-block; padding:15px 28px; border:1px solid var(--border); border-radius:13px; background:var(--bg-card); color:var(--text); font-size:16px; font-weight:600; cursor:pointer; text-decoration:none; }

  @media (max-width: 920px) {
    .sp-hero { grid-template-columns:1fr; padding:128px 24px 56px; gap:40px; }
    .sp-section { padding:64px 24px; }
    .sp-grid-3 { grid-template-columns:1fr; }
    .sp-strip-inner { padding:22px 24px; gap:22px; }
    .sp-fee-row { padding:13px 16px; grid-template-columns:1.4fr 1fr 1fr 1fr; font-size:13px; }
  }
</style>

<div data-controller="landing-nav" style="font-family:<%= body_font %>">
  <%# ─── Nav ─── %>
  <nav data-landing-nav-target="nav" style="position:fixed;top:0;left:0;right:0;z-index:100;background:transparent;transition:all 0.3s ease;font-family:<%= body_font %>">
    <div style="max-width:1160px;margin:0 auto;padding:0 24px;height:68px;display:flex;align-items:center;justify-content:space-between">
      <div style="display:flex;align-items:center;gap:10px">
        <%= image_tag "smart-pay-logo.png", alt: "SmartPay", class: "logo-dark h-12 w-auto" %>
        <%= image_tag "smart-logo-light.png", alt: "SmartPay", class: "logo-light h-12 w-auto" %>
      </div>
      <div style="gap:36px" class="hidden md:flex">
        <a href="#features" style="font-size:14px;color:var(--nav-link);text-decoration:none">Features</a>
        <a href="#payments" style="font-size:14px;color:var(--nav-link);text-decoration:none">Payments</a>
        <a href="#pricing" style="font-size:14px;color:var(--nav-link);text-decoration:none">Pricing</a>
        <a href="#for-who" style="font-size:14px;color:var(--nav-link);text-decoration:none">About</a>
      </div>
      <div style="display:flex;gap:10px;align-items:center">
        <button data-action="theme#toggle" data-theme-target="icon" class="hidden md:flex items-center gap-1.5" style="background:none;border:1px solid var(--border);border-radius:8px;color:var(--nav-link);cursor:pointer;padding:7px 10px">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
        <%= link_to "Sign in", new_user_session_path, class: "hidden md:inline-block", style: "font-size:13px;color:var(--nav-link);text-decoration:none;padding:8px 16px" %>
        <%= link_to new_user_registration_path, class: "hidden md:flex items-center gap-1.5", style: "background:var(--primary);color:var(--primary-ink);text-decoration:none;padding:9px 20px;border-radius:8px;font-size:13px;font-weight:600;font-family:#{body_font}" do %>
          Get started
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        <% end %>
        <button data-action="landing-nav#toggleMobile" class="md:hidden" style="background:none;border:none;color:var(--text);cursor:pointer;padding:4px">
          <svg id="menu-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
      </div>
    </div>

    <div data-landing-nav-target="mobileMenu" class="hidden md:hidden" style="background:var(--hero-bg);border-top:1px solid var(--border-light);padding:16px 24px 24px">
      <% [["Features", "#features"], ["Payments", "#payments"], ["Pricing", "#pricing"], ["About", "#for-who"]].each do |label, href| %>
        <a href="<%= href %>" data-action="landing-nav#closeMobile" style="display:block;padding:12px 0;font-size:15px;color:var(--text-dim);text-decoration:none;border-bottom:1px solid var(--border-light)"><%= label %></a>
      <% end %>
      <div style="display:flex;gap:10px;margin-top:16px">
        <button data-action="theme#toggle" style="padding:10px;border:1px solid var(--border);border-radius:8px;color:var(--text-dim);font-size:14px;font-weight:500;font-family:<%= body_font %>;background:var(--input-bg);cursor:pointer;text-align:center">
          <span data-theme-target="label">Light Mode</span>
        </button>
        <%= link_to "Sign in", new_user_session_path, style: "flex:1;text-align:center;padding:10px;border:1px solid var(--border);border-radius:8px;color:var(--text-dim);text-decoration:none;font-size:14px;font-weight:500;font-family:#{body_font}" %>
        <%= link_to "Get started", new_user_registration_path, style: "flex:1;text-align:center;padding:10px;background:var(--primary);border-radius:8px;color:var(--primary-ink);text-decoration:none;font-size:14px;font-weight:600;font-family:#{body_font}" %>
      </div>
    </div>
  </nav>

  <div style="animation:spIn .4s ease both;background:var(--bg);color:var(--text)">
    <%# ─── Hero ─── %>
    <section class="sp-hero">
      <div>
        <div style="display:inline-flex;align-items:center;gap:8px;padding:6px 14px;border-radius:999px;background:rgba(var(--primary-rgb),0.12);color:var(--primary);font-size:13px;font-weight:600;margin-bottom:26px">
          <span style="width:7px;height:7px;border-radius:99px;background:var(--primary)"></span>Built for The Gambia · Now live
        </div>
        <h1 style="font-family:<%= display %>;font-weight:800;font-size:clamp(46px,6vw,82px);line-height:.95;letter-spacing:-.03em;color:var(--text);margin-bottom:24px">Get paid.<br><span style="color:var(--primary)">Smartly.</span></h1>
        <p style="font-size:19px;line-height:1.55;color:var(--text-muted);max-width:460px;margin-bottom:34px">The payment platform built for Gambian businesses and freelancers. Accept Wave, Visa, Afrimoney, QMoney &amp; APS — locally and across borders.</p>
        <div style="display:flex;gap:13px;flex-wrap:wrap">
          <%= link_to "Start for free", new_user_registration_path, class: "sp-btn-primary" %>
          <%= link_to "See the dashboard", new_user_session_path, class: "sp-btn-ghost" %>
        </div>
        <div style="display:flex;gap:30px;margin-top:48px">
          <% [["D1.4M+", "Processed"], ["1,000+", "Businesses"], ["< 3s", "Settlement"]].each do |v, k| %>
            <div>
              <div style="font-family:<%= display %>;font-weight:700;font-size:26px;color:var(--text)"><%= v %></div>
              <div style="font-size:13px;color:var(--text-muted)"><%= k %></div>
            </div>
          <% end %>
        </div>
      </div>

      <%# hero revenue card %>
      <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:24px;padding:26px;box-shadow:0 30px 70px -30px rgba(var(--primary-rgb),0.4)">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
          <span style="font-size:13px;color:var(--text-muted);font-weight:600">Revenue · <%= Date.current.strftime("%b %Y") %></span>
          <span style="font-size:12px;font-weight:600;color:var(--primary);background:rgba(var(--primary-rgb),0.12);padding:4px 9px;border-radius:7px">↑ 18.4%</span>
        </div>
        <div style="font-family:<%= display %>;font-weight:700;font-size:40px;color:var(--text);letter-spacing:-.02em">D142,800</div>
        <div style="display:flex;align-items:flex-end;gap:7px;height:120px;margin:22px 0 14px">
          <% [40, 55, 48, 62, 58, 70, 66, 78, 72, 85, 80, 95].each_with_index do |h, idx| %>
            <div style="flex:1;height:<%= h %>%;border-radius:6px 6px 3px 3px;background:<%= idx > 9 ? 'var(--primary)' : 'rgba(var(--primary-rgb),0.3)' %>;transform-origin:bottom;animation:spGrow .5s <%= idx * 0.03 %>s ease both"></div>
          <% end %>
        </div>
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px">
          <% [["Wave", "D64k", 155], ["Visa", "D38k", 265], ["Afrimoney", "D40k", 55]].each do |name, amt, hue| %>
            <div style="background:var(--bg-alt);border-radius:12px;padding:12px">
              <div style="display:flex;align-items:center;gap:6px;font-size:12px;color:var(--text-muted);margin-bottom:4px"><span style="width:9px;height:9px;border-radius:99px;background:oklch(.6 .13 <%= hue %>);flex-shrink:0"></span><%= name %></div>
              <div style="font-weight:700;font-size:17px;color:var(--text)"><%= amt %></div>
            </div>
          <% end %>
        </div>
      </div>
    </section>

    <%# ─── Payment methods strip ─── %>
    <section id="payments" style="border-top:1px solid var(--border);border-bottom:1px solid var(--border);background:var(--bg-card)">
      <div class="sp-strip-inner">
        <span style="font-size:13px;color:var(--text-muted);font-weight:600;text-transform:uppercase;letter-spacing:.08em">Accepted methods</span>
        <% [["W", "Wave"], ["V", "Visa"], ["A", "Afrimoney"], ["Q", "QMoney"], ["A", "APS"]].each do |i, name| %>
          <div style="display:flex;align-items:center;gap:10px">
            <span class="sp-badge"><%= i %></span>
            <span style="font-weight:600;color:var(--text)"><%= name %></span>
          </div>
        <% end %>
      </div>
    </section>

    <%# ─── Features ─── %>
    <section id="features" class="sp-section">
      <div style="max-width:620px;margin-bottom:48px">
        <div style="color:var(--primary);font-weight:600;font-size:14px;margin-bottom:12px">Platform features</div>
        <h2 style="font-family:<%= display %>;font-weight:700;font-size:clamp(30px,4vw,46px);letter-spacing:-.02em;line-height:1.05;color:var(--text)">Everything you need to run a modern business</h2>
      </div>
      <div class="sp-grid-3">
        <% [
          ["◴", "Local & international", "Accept GMD and major currencies. Serve customers in Gambia and across the globe from one account."],
          ["⚡", "Instant settlement", "Money moves fast — real-time payouts with automatic reconciliation and phone notifications."],
          ["⛨", "Bank-grade security", "End-to-end encryption on every transaction. PCI-DSS compliant infrastructure."],
          ["▤", "Smart invoicing", "Generate professional invoices in seconds with built-in payment links."],
          ["◧", "Real-time analytics", "Live dashboards show exactly where your money is, by channel and period."],
          ["⇄", "Auto reconciliation", "SmartPay matches every incoming payment to the right invoice — no spreadsheets."]
        ].each do |i, t, d| %>
          <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:18px;padding:26px">
            <div style="width:42px;height:42px;border-radius:12px;background:rgba(var(--primary-rgb),0.13);display:flex;align-items:center;justify-content:center;margin-bottom:18px;color:var(--primary);font-size:18px;font-weight:700"><%= i %></div>
            <h3 style="font-family:<%= display %>;font-weight:600;font-size:19px;color:var(--text);margin-bottom:8px"><%= t %></h3>
            <p style="font-size:14.5px;line-height:1.55;color:var(--text-muted)"><%= d %></p>
          </div>
        <% end %>
      </div>
    </section>

    <%# ─── Pricing ─── %>
    <section id="pricing" style="background:var(--bg-card);border-top:1px solid var(--border)">
      <div class="sp-section">
        <div style="text-align:center;max-width:560px;margin:0 auto 44px">
          <div style="color:var(--primary);font-weight:600;font-size:14px;margin-bottom:12px">Transparent pricing</div>
          <h2 style="font-family:<%= display %>;font-weight:700;font-size:clamp(30px,4vw,46px);letter-spacing:-.02em;color:var(--text)">Pay only when you get paid</h2>
        </div>
        <div style="max-width:760px;margin:0 auto;background:var(--bg);border:1px solid var(--border);border-radius:18px;overflow:hidden">
          <div class="sp-fee-row" style="background:var(--bg-alt);font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--text-muted);padding-top:15px;padding-bottom:15px">
            <span>Method</span><span>Rate</span><span>Min fee</span><span>Settlement</span>
          </div>
          <% [
            ["Wave", "1.5%", "D1.00", "~30 min", 155],
            ["APS", "1.2%", "D1.00", "~30 min", 55],
            ["Afrimoney", "1.2%", "D1.00", "~30 min", 55],
            ["QMoney", "1.0%", "D1.00", "~30 min", 300],
            ["Bank Transfer", "1.25%", "D10", "Next day", 200],
            ["Visa", "3.5%", "D75.00", "2–3 days", 265]
          ].each do |name, rate, min, set, hue| %>
            <div class="sp-fee-row" style="border-top:1px solid var(--border);font-size:15px;color:var(--text)">
              <span style="display:flex;align-items:center;gap:9px;font-weight:600"><span style="width:9px;height:9px;border-radius:99px;background:oklch(.6 .13 <%= hue %>);flex-shrink:0"></span><%= name %></span>
              <span style="font-weight:700"><%= rate %></span>
              <span style="color:var(--text-muted)"><%= min %></span>
              <span style="color:var(--text-muted)"><%= set %></span>
            </div>
          <% end %>
        </div>
        <p style="text-align:center;font-size:13px;color:var(--text-muted);margin-top:16px">All rates include a 1% SmartPay platform fee.</p>
      </div>
    </section>

    <%# ─── Audience ─── %>
    <section id="for-who" class="sp-section">
      <h2 style="font-family:<%= display %>;font-weight:700;font-size:clamp(30px,4vw,46px);letter-spacing:-.02em;color:var(--text);margin-bottom:44px;max-width:560px">Built for every Gambian business</h2>
      <div class="sp-grid-3">
        <% [
          ["Shops, restaurants, markets", "Small businesses", ["QR payments at point of sale", "WhatsApp payment links", "Daily cash-out to mobile money"]],
          ["Designers, devs, consultants", "Freelancers", ["Multi-currency invoicing", "Automatic FX conversion", "Client portal for online payment"]],
          ["Importers, exporters, NGOs", "Enterprises", ["REST API integration", "Multi-user team access", "Custom reconciliation reports"]]
        ].each do |tag, t, points| %>
          <div style="border:1px solid var(--border);border-radius:18px;padding:28px;background:var(--bg-card)">
            <div style="font-size:13px;color:var(--accent);font-weight:600;margin-bottom:14px"><%= tag %></div>
            <h3 style="font-family:<%= display %>;font-weight:700;font-size:23px;color:var(--text);margin-bottom:18px"><%= t %></h3>
            <div style="display:flex;flex-direction:column;gap:11px">
              <% points.each do |pt| %>
                <div style="display:flex;gap:10px;align-items:flex-start;font-size:14.5px;color:var(--text-muted)"><span style="color:var(--primary);font-weight:700">✓</span><%= pt %></div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </section>

    <%# ─── CTA ─── %>
    <section style="max-width:1180px;margin:0 auto 84px;padding:0 40px">
      <div style="background:var(--primary);border-radius:28px;padding:64px 48px;text-align:center;color:var(--primary-ink)">
        <h2 style="font-family:<%= display %>;font-weight:800;font-size:clamp(32px,4.5vw,52px);letter-spacing:-.02em;margin-bottom:16px">Ready to get paid smartly?</h2>
        <p style="font-size:18px;opacity:.85;max-width:480px;margin:0 auto 30px">Set up your account in 3 minutes — no paperwork, no waiting.</p>
        <div style="display:flex;gap:13px;justify-content:center;flex-wrap:wrap">
          <%= link_to "Create free account", new_user_registration_path, style: "padding:15px 30px;border-radius:13px;background:var(--primary-ink);color:var(--primary);font-size:16px;font-weight:700;text-decoration:none" %>
          <%= link_to "Sign in", new_user_session_path, style: "padding:15px 30px;border:1px solid color-mix(in oklch, var(--primary-ink) 40%, transparent);border-radius:13px;background:transparent;color:var(--primary-ink);font-size:16px;font-weight:600;text-decoration:none" %>
        </div>
      </div>
    </section>

    <footer style="border-top:1px solid var(--border);padding:40px;text-align:center;color:var(--text-muted);font-size:13px">© <%= Date.current.year %> SmartPay Ltd · Banjul, The Gambia</footer>
  </div>
</div>
