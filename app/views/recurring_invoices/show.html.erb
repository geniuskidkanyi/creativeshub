<div class="px-6 py-6 max-w-3xl">
  <div class="mb-6">
    <%= link_to "← Recurring invoices", recurring_invoices_path, class: "text-xs text-muted-foreground hover:text-foreground transition-colors" %>
    <div class="flex items-center gap-3 mt-3">
      <h1 class="text-2xl text-foreground" style="font-family: var(--font-display)"><%= @recurring_invoice.title.presence || @recurring_invoice.client.name %></h1>
      <%= render "recurring_invoices/status_badge", schedule: @recurring_invoice %>
    </div>
    <p class="text-sm text-muted-foreground mt-1"><%= @recurring_invoice.client.name %> · <%= @recurring_invoice.schedule_description %></p>
  </div>

  <div class="bg-card border border-border rounded-lg p-5 mb-4">
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      <div>
        <div class="text-xl text-foreground font-semibold"><%= @recurring_invoice.currency_symbol %><%= number_with_delimiter(@recurring_invoice.estimated_total) %></div>
        <div class="text-xs text-muted-foreground">Per invoice</div>
      </div>
      <div>
        <div class="text-xl text-foreground font-semibold"><%= @recurring_invoice.occurrences_count %></div>
        <div class="text-xs text-muted-foreground">Invoices sent</div>
      </div>
      <div>
        <div class="text-xl text-foreground font-semibold"><%= @recurring_invoice.active? && @recurring_invoice.next_run_on ? @recurring_invoice.next_run_on.to_fs(:long) : "—" %></div>
        <div class="text-xs text-muted-foreground">Next invoice</div>
      </div>
      <div>
        <div class="text-xl text-foreground font-semibold"><%= @recurring_invoice.auto_send? ? "On" : "Off" %></div>
        <div class="text-xs text-muted-foreground">Auto-email</div>
      </div>
    </div>

    <% if @recurring_invoice.auto_send? && !@recurring_invoice.client.emailable? %>
      <p class="text-xs text-amber-500 mt-4 pt-4 border-t border-border">Auto-email is on but <%= @recurring_invoice.client.name %> has no email address — invoices will be created but not sent.</p>
    <% end %>
  </div>

  <div class="bg-card border border-border rounded-lg overflow-hidden mb-4">
    <div class="px-4 py-3 border-b border-border text-sm text-foreground font-medium">Line items</div>
    <div class="divide-y divide-border">
      <% @recurring_invoice.recurring_invoice_items.each do |item| %>
        <div class="px-4 py-2.5 flex items-center justify-between gap-3">
          <span class="text-sm text-foreground truncate"><%= item.description %></span>
          <span class="text-sm text-muted-foreground shrink-0"><%= item.quantity.to_f %> × <%= @recurring_invoice.currency_symbol %><%= number_with_delimiter(item.unit_price) %></span>
        </div>
      <% end %>
    </div>
  </div>

  <div class="flex flex-wrap gap-3 mb-6">
    <%= link_to "Edit", edit_recurring_invoice_path(@recurring_invoice), class: "px-4 py-2 rounded-md bg-secondary text-secondary-foreground text-sm font-medium" %>
    <% if @recurring_invoice.active? %>
      <%= button_to "Pause", pause_recurring_invoice_path(@recurring_invoice), class: "px-4 py-2 rounded-md bg-secondary text-secondary-foreground text-sm font-medium cursor-pointer" %>
      <%= button_to "Generate now", generate_now_recurring_invoice_path(@recurring_invoice), class: "px-4 py-2 rounded-md bg-primary text-primary-foreground text-sm font-medium cursor-pointer" %>
    <% elsif @recurring_invoice.paused? %>
      <%= button_to "Resume", resume_recurring_invoice_path(@recurring_invoice), class: "px-4 py-2 rounded-md bg-primary text-primary-foreground text-sm font-medium cursor-pointer" %>
    <% end %>
    <%= button_to "Delete", recurring_invoice_path(@recurring_invoice), method: :delete,
          class: "px-4 py-2 rounded-md text-sm font-medium text-destructive cursor-pointer",
          form: { data: { turbo_confirm: "Delete this schedule? Invoices it already created are kept." } } %>
  </div>

  <% if @invoices.any? %>
    <h2 class="text-sm text-foreground font-medium mb-3">Invoices from this schedule</h2>
    <div class="space-y-2">
      <% @invoices.each do |invoice| %>
        <%= link_to invoice_path(invoice), class: "flex items-center justify-between bg-card border border-border rounded-lg px-4 py-3 hover:border-primary/40 transition-colors" do %>
          <div>
            <div class="text-sm text-foreground"><%= invoice.invoice_number %></div>
            <div class="text-xs text-muted-foreground"><%= invoice.issue_date&.to_fs(:long) %></div>
          </div>
          <div class="text-right">
            <div class="text-sm text-foreground font-semibold"><%= invoice.currency_symbol %><%= number_with_delimiter(invoice.total_amount) %></div>
            <div class="text-xs text-muted-foreground"><%= invoice.status %></div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
