<div style="background:#0d111b;padding:40px 0;font-family:'Hanken Grotesk',system-ui,sans-serif">
  <div style="max-width:480px;margin:0 auto;background:#151a26;border:1px solid rgba(238,242,249,0.08);border-radius:12px;padding:32px;color:#eef2f9">
    <div style="text-align:center;margin-bottom:24px">
      <h1 style="font-family:'Bricolage Grotesque',Georgia,sans-serif;font-size:20px;font-weight:500;color:#eef2f9;margin:0 0 8px">SmartPay</h1>
      <p style="font-size:14px;color:#9ea5b2;margin:0">Reset your password</p>
    </div>

    <p style="font-size:14px;color:#b7bdc9;line-height:1.6;margin:0 0 20px">Someone requested a password reset for your SmartPay account. Click below to choose a new password.</p>

    <div style="text-align:center;margin:28px 0">
      <%= link_to 'Change my password', edit_password_url(@resource, reset_password_token: @token), style: "display:inline-block;background:#709afb;color:#091123;text-decoration:none;padding:12px 32px;border-radius:8px;font-size:14px;font-weight:600;font-family:'Hanken Grotesk',system-ui,sans-serif" %>
    </div>

    <p style="font-size:12px;color:#9ea5b2;line-height:1.5;margin:0">If you didn't request this, you can ignore this email. Your password won't change.</p>

    <div style="margin-top:28px;padding-top:20px;border-top:1px solid rgba(238,242,249,0.08);text-align:center">
      <p style="font-size:11px;color:#9ea5b2;margin:0">SmartPay — The payment platform for Gambian businesses</p>
    </div>
  </div>
</div>
