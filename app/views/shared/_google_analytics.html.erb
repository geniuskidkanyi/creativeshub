<% if google_analytics_enabled? %>
  <% ga_id = Rails.configuration.x.google_analytics_id %>
  <script async src="https://www.googletagmanager.com/gtag/js?id=<%= ga_id %>"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    gtag('js', new Date());
    // send_page_view:false — Turbo swaps pages without a full reload, so we
    // send page_view ourselves on every turbo:load (which also fires on the
    // very first load), avoiding both misses and double counts.
    gtag('config', '<%= ga_id %>', { send_page_view: false });

    document.addEventListener('turbo:load', function () {
      gtag('event', 'page_view', {
        page_location: window.location.href,
        page_title: document.title
      });
    });
  </script>

  <% if flash[:ga_events].present? %>
    <script>
      document.addEventListener('turbo:load', function fireQueuedGaEvents() {
        document.removeEventListener('turbo:load', fireQueuedGaEvents);
        <% flash[:ga_events].each do |event| %>
          gtag('event', <%= raw event["name"].to_json %>, <%= raw((event["params"] || {}).to_json) %>);
        <% end %>
      });
    </script>
  <% end %>
<% end %>
