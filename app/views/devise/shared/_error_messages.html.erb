<% if resource.errors.any? %>
  <div class="rounded-md bg-destructive/10 border border-destructive/30 p-4 mb-6">
    <h3 class="text-sm font-medium text-destructive">
      <%= pluralize(resource.errors.count, "error") %> prohibited this from being saved:
    </h3>
    <ul class="mt-2 list-disc pl-5 space-y-1 text-sm text-destructive-foreground">
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
