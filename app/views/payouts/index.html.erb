<% content_for(:title) { "Payouts" } %>
<div class="px-5 py-7 lg:px-9 lg:py-8 max-w-[1240px]">
  <div class="flex flex-wrap items-end justify-between gap-3 mb-7">
    <div>
      <h1 class="text-[28px] text-foreground">Payouts</h1>
      <p class="text-sm text-muted-foreground mt-1">Money sent from your SmartPay balance to your wallet.</p>
    </div>
    <%= link_to "+ Cash out", new_payout_path, class: "px-5 py-[11px] rounded-lg bg-primary text-primary-foreground text-sm font-semibold hover:brightness-110 transition-all" %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-3.5 mb-[18px]">
    <div class="bg-card border border-border rounded-2xl p-[18px]">
      <div class="text-[13px] text-muted-foreground mb-2">Available balance</div>
      <div class="font-display font-bold text-[24px] text-foreground tracking-tight">D<%= number_with_delimiter(number_with_precision(@available_balance, precision: 2)) %></div>
    </div>
    <div class="bg-card border border-border rounded-2xl p-[18px]">
      <div class="text-[13px] text-muted-foreground mb-2">Total earned</div>
      <div class="font-display font-bold text-[24px] text-foreground tracking-tight">D<%= number_with_delimiter(number_with_precision(current_account.total_earnings, precision: 2)) %></div>
    </div>
    <div class="bg-card border border-border rounded-2xl p-[18px]">
      <div class="text-[13px] text-muted-foreground mb-2">Total paid out</div>
      <div class="font-display font-bold text-[24px] text-foreground tracking-tight">D<%= number_with_delimiter(number_with_precision(current_account.total_paid_out, precision: 2)) %></div>
    </div>
  </div>

  <div class="bg-card border border-border rounded-2xl overflow-hidden">
    <div class="hidden sm:grid grid-cols-[1.4fr_1fr_1fr_1fr_1fr] px-[22px] py-3 bg-secondary/60 text-xs font-bold uppercase tracking-wider text-muted-foreground">
      <span>Destination</span><span>Network</span><span>Amount</span><span>Fee</span><span>Status</span>
    </div>
    <% if @payouts.any? %>
      <% @payouts.each do |payout| %>
        <div class="grid grid-cols-[1.4fr_1fr_auto] sm:grid-cols-[1.4fr_1fr_1fr_1fr_1fr] items-center gap-2 px-[22px] py-[15px] border-t border-border text-sm">
          <span class="flex items-center gap-3 min-w-0">
            <span class="w-[34px] h-[34px] rounded-[10px] bg-primary/15 text-primary inline-flex items-center justify-center font-bold text-sm shrink-0"><%= payout.network.first.upcase %></span>
            <span class="min-w-0">
              <span class="block text-foreground font-semibold truncate"><%= payout.beneficiary_name %></span>
              <span class="block text-xs text-muted-foreground font-mono"><%= payout.account_number %> · <%= payout.created_at.strftime("%b %d, %Y") %></span>
            </span>
          </span>
          <span class="text-muted-foreground hidden sm:block"><%= payout.network.titleize %></span>
          <span class="font-bold text-foreground">D<%= number_with_delimiter(number_with_precision(payout.amount, precision: 2)) %></span>
          <span class="text-muted-foreground hidden sm:block"><%= payout.fee ? "D#{number_with_precision(payout.fee, precision: 2)}" : "—" %></span>
          <span>
            <span class="text-xs font-semibold px-2.5 py-1 rounded-md <%= payout_status_badge(payout.status) %>"><%= payout.status.humanize %></span>
            <% if payout.failed? && payout.error_message.present? %>
              <span class="block text-xs text-muted-foreground mt-1 truncate max-w-[180px]" title="<%= payout.error_message %>"><%= payout.error_message %></span>
            <% end %>
          </span>
        </div>
      <% end %>
    <% else %>
      <div class="px-[22px] py-10 text-center border-t border-border">
        <p class="text-sm text-muted-foreground mb-3">No payouts yet. When customers pay your invoices, your share builds up here and you can cash it out to your wallet.</p>
        <%= link_to "Make your first payout", new_payout_path, class: "text-sm text-primary font-semibold" %>
      </div>
    <% end %>
  </div>
</div>
