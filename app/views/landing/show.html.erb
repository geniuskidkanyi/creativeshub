<%# ─── Shared style helpers ─── %>
<%
display = "'Unbounded', sans-serif"
body_font = "'Plus Jakarta Sans', system-ui, sans-serif"
mono = "'Geist Mono', monospace"
green = "#c9a84c"
green_dark = "#b8943a"
%>

<div data-controller="landing-nav">
  <%# ─── Nav ─── %>
  <nav data-landing-nav-target="nav" style="position:fixed;top:0;left:0;right:0;z-index:100;background:transparent;transition:all 0.3s ease;font-family:<%= body_font %>">
    <div style="max-width:1160px;margin:0 auto;padding:0 24px;height:68px;display:flex;align-items:center;justify-content:space-between">
      <div style="display:flex;align-items:center;gap:10px">
        <%= image_tag "smart-pay-logo.png", alt: "SmartPay", class: "logo-dark h-12 w-auto" %>
        <%= image_tag "smart-logo-light.png", alt: "SmartPay", class: "logo-light h-12 w-auto" %>
      </div>
      <div style="gap:36px" class="hidden md:flex">
        <a href="#features" style="font-size:14px;color:var(--nav-link);text-decoration:none" class="hover:text-white">Features</a>
        <a href="#payments" style="font-size:14px;color:var(--nav-link);text-decoration:none" class="hover:text-white">Payments</a>
        <a href="#pricing" style="font-size:14px;color:var(--nav-link);text-decoration:none" class="hover:text-white">Pricing</a>
        <a href="#for-who" style="font-size:14px;color:var(--nav-link);text-decoration:none" class="hover:text-white">About</a>
      </div>
      <div style="display:flex;gap:10px;align-items:center">
        <button data-action="theme#toggle" data-theme-target="icon" class="hidden md:flex items-center gap-1.5" style="background:none;border:1px solid var(--border);border-radius:8px;color:var(--nav-link);cursor:pointer;padding:7px 10px">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
        <%= link_to "Sign in", new_user_session_path, class: "hidden md:inline-block", style: "font-size:13px;color:var(--nav-link);text-decoration:none;padding:8px 16px" %>
        <%= link_to new_user_registration_path, class: "hidden md:flex items-center gap-1.5", style: "background:#c9a84c;color:#0d0f14;text-decoration:none;padding:9px 20px;border-radius:8px;font-size:13px;font-weight:600;font-family:#{body_font}" do %>
          Get started
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        <% end %>
        <button data-action="landing-nav#toggleMobile" class="md:hidden" style="background:none;border:none;color:var(--text);cursor:pointer;padding:4px">
          <svg id="menu-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
      </div>
    </div>

    <div data-landing-nav-target="mobileMenu" class="hidden md:hidden" style="background:var(--hero-bg);border-top:1px solid var(--border-light);padding:16px 24px 24px">
      <% [["Features", "#features"], ["Payments", "#payments"], ["Pricing", "#pricing"], ["About", "#for-who"]].each do |label, href| %>
        <a href="<%= href %>" data-action="landing-nav#closeMobile" style="display:block;padding:12px 0;font-size:15px;color:var(--text-dim);text-decoration:none;border-bottom:1px solid var(--border-light)"><%= label %></a>
      <% end %>
      <div style="display:flex;gap:10px;margin-top:16px">
        <button data-action="theme#toggle" style="padding:10px;border:1px solid var(--border);border-radius:8px;color:var(--text-dim);font-size:14px;font-weight:500;font-family:<%= body_font %>;background:var(--input-bg);cursor:pointer;text-align:center">
          <span data-theme-target="label">Light Mode</span>
        </button>
        <%= link_to "Sign in", new_user_session_path, style: "flex:1;text-align:center;padding:10px;border:1px solid var(--border);border-radius:8px;color:var(--text-dim);text-decoration:none;font-size:14px;font-weight:500;font-family:#{body_font}" %>
        <%= link_to "Get started", new_user_registration_path, style: "flex:1;text-align:center;padding:10px;background:#c9a84c;border-radius:8px;color:#0d0f14;text-decoration:none;font-size:14px;font-weight:600;font-family:#{body_font}" %>
      </div>
    </div>
  </nav>

  <%# ─── Hero ─── %>
  <section style="background:var(--hero-bg);min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:120px 24px 80px;position:relative;overflow:hidden;font-family:<%= body_font %>">
    <div style="position:absolute;inset:0;background-image:linear-gradient(rgba(201,168,76,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(201,168,76,0.04) 1px, transparent 1px);background-size:60px 60px;mask-image:radial-gradient(ellipse 80% 60% at 50% 50%, black 30%, transparent 100%);-webkit-mask-image:radial-gradient(ellipse 80% 60% at 50% 50%, black 30%, transparent 100%)"></div>
    <div style="position:absolute;top:20%;left:50%;transform:translateX(-50%);width:600px;height:400px;background:radial-gradient(ellipse, rgba(201,168,76,0.12) 0%, transparent 70%);pointer-events:none"></div>

    <div style="position:relative;text-align:center;max-width:860px">
      <div style="display:inline-flex;align-items:center;gap:8px;background:rgba(201,168,76,0.1);border:1px solid rgba(201,168,76,0.25);border-radius:100px;padding:6px 16px 6px 10px;margin-bottom:36px">
        <div style="width:6px;height:6px;border-radius:50%;background:#c9a84c"></div>
        <span style="font-size:12px;color:#c9a84c;font-family:<%= mono %>;letter-spacing:0.06em">Built for The Gambia · Now Live</span>
      </div>

      <h1 style="font-family:<%= display %>;font-size:clamp(40px, 7vw, 80px);font-weight:800;color:var(--text);line-height:1.05;letter-spacing:-0.04em;margin:0 0 8px">Get Paid.</h1>
      <h1 style="font-family:<%= display %>;font-size:clamp(40px, 7vw, 80px);font-weight:800;line-height:1.05;letter-spacing:-0.04em;margin:0 0 32px;background:linear-gradient(90deg, #c9a84c 0%, #e4cc82 60%, #c9a84c 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text">Smartly.</h1>

      <p style="font-size:clamp(16px, 2.2vw, 20px);color:var(--text-dim);line-height:1.7;max-width:560px;margin:0 auto 48px;font-weight:400">
        The payment platform built for Gambian businesses and freelancers. Accept Wave, Visa, Afrimoney, QMoney, and APS — locally and across borders.
      </p>

      <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-bottom:64px">
        <%= link_to new_user_registration_path, style: "display:flex;align-items:center;gap:8px;background:#c9a84c;color:#0d0f14;text-decoration:none;padding:14px 28px;border-radius:10px;font-size:15px;font-weight:700;font-family:#{body_font};box-shadow:0 0 32px rgba(201,168,76,0.3)" do %>
          Start for free
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        <% end %>
        <a href="#features" style="display:flex;align-items:center;gap:8px;background:var(--input-bg);border:1px solid var(--border);color:var(--text);text-decoration:none;padding:14px 28px;border-radius:10px;font-size:15px;font-weight:500;font-family:<%= body_font %>">See how it works</a>
      </div>

      <div>
        <p style="font-size:11px;color:var(--text-faint);font-family:<%= mono %>;letter-spacing:0.12em;text-transform:uppercase;margin-bottom:16px">Accepted payment methods</p>
        <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap">
          <% [{name:"Wave",color:"#1a9bdc",letter:"W"}, {name:"Visa",color:"#1a1f71",letter:"V"}, {name:"Afrimoney",color:"#f97316",letter:"A"}, {name:"QMoney",color:"#8b5cf6",letter:"Q"}, {name:"APS",color:"#10b981",letter:"A"}].each do |m| %>
            <div style="display:flex;align-items:center;gap:8px;background:var(--input-bg);border:1px solid rgba(255,255,255,0.1);border-radius:100px;padding:6px 14px 6px 8px">
              <div style="width:22px;height:22px;border-radius:50%;background:<%= m[:color] %>;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;color:#fff;font-family:<%= display %>"><%= m[:letter] %></div>
              <span style="font-size:13px;font-weight:500;color:var(--text-dim);font-family:<%= body_font %>"><%= m[:name] %></span>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div style="position:absolute;bottom:32px;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:6px">
      <span style="font-size:10px;color:var(--text-faint);font-family:<%= mono %>;letter-spacing:0.1em">SCROLL</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--text-faint)" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
    </div>
  </section>

  <%# ─── Stats Bar ─── %>
  <div style="background:var(--bg-alt);border-top:1px solid var(--border-light);border-bottom:1px solid var(--border-light);font-family:<%= body_font %>">
    <style>
      .stats-grid { display:grid; grid-template-columns:repeat(2, 1fr); }
      .stats-cell { padding:32px 0; text-align:center; }
      .stats-cell:nth-child(odd) { border-right:1px solid var(--border-light); }
      @media (min-width:768px) {
        .stats-grid { grid-template-columns:repeat(4, 1fr); }
        .stats-cell { border-right:1px solid var(--border-light); }
        .stats-cell:last-child { border-right:none; }
      }
    </style>
    <div style="max-width:1160px;margin:0 auto;padding:0 24px" class="stats-grid">
       <% [{value:"D1.4M+",label:"Processed in GMD"},{value:"1,000+",label:"Active businesses"},{value:"99.97%",label:"Uptime"},{value:"< 3 sec",label:"Avg. settlement"}].each_with_index do |s,i| %>
        <div class="stats-cell">
          <p style="font-family:<%= display %>;font-size:clamp(22px,3vw,32px);font-weight:700;color:#c9a84c;margin:0 0 6px;letter-spacing:-0.03em"><%= s[:value] %></p>
          <p style="font-size:13px;color:var(--text-muted);margin:0;font-family:<%= mono %>;letter-spacing:0.04em"><%= s[:label] %></p>
        </div>
      <% end %>
    </div>
  </div>

  <%# ─── Payments Section ─── %>
  <section id="payments" style="background:var(--hero-bg);padding:100px 24px;font-family:<%= body_font %>">
    <div style="max-width:1160px;margin:0 auto">
      <div style="text-align:center;margin-bottom:64px">
        <p style="font-family:<%= mono %>;font-size:11px;color:#c9a84c;letter-spacing:0.14em;text-transform:uppercase;margin-bottom:16px">Payment Methods</p>
        <h2 style="font-family:<%= display %>;font-size:clamp(28px,4vw,44px);font-weight:700;color:var(--text);margin:0 0 16px;letter-spacing:-0.03em">Every way your customers pay</h2>
        <p style="font-size:16px;color:var(--text-muted);max-width:480px;margin:0 auto;line-height:1.7">One platform. Five channels. Zero friction — whether your customer is in Banjul or Birmingham.</p>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:16px">
        <% [
          {name:"Wave",color:"#1a9bdc",type:"Mobile Money",desc:"Mobile money for West Africa",letter:"W"},
          {name:"Visa",color:"#1a1f71",type:"Card",desc:"Global card network",letter:"V"},
          {name:"Afrimoney",color:"#f97316",type:"Mobile Money",desc:"Gambian mobile money",letter:"A"},
          {name:"QMoney",color:"#8b5cf6",type:"Digital Wallet",desc:"Local digital wallet",letter:"Q"},
          {name:"APS",color:"#10b981",type:"Bank Transfer",desc:"Automated payment system",letter:"A"}
        ].each do |m| %>
          <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:16px;padding:28px 24px;position:relative;overflow:hidden">
            <div style="position:absolute;top:0;right:0;width:80px;height:80px;background:radial-gradient(circle at top right, <%= m[:color] %>18, transparent 70%)"></div>
            <div style="width:44px;height:44px;border-radius:12px;background:<%= m[:color] %>22;border:1px solid <%= m[:color] %>44;display:flex;align-items:center;justify-content:center;margin-bottom:20px;font-family:<%= display %>;font-size:16px;font-weight:700;color:<%= m[:color] %>"><%= m[:letter] %></div>
            <div style="display:inline-block;background:<%= m[:color] %>18;border:1px solid <%= m[:color] %>30;border-radius:4px;padding:2px 8px;margin-bottom:10px">
              <span style="font-size:10px;font-family:<%= mono %>;color:<%= m[:color] %>;letter-spacing:0.08em;text-transform:uppercase"><%= m[:type] %></span>
            </div>
            <h3 style="font-family:<%= display %>;font-size:17px;font-weight:600;color:var(--text);margin:0 0 8px;letter-spacing:-0.02em"><%= m[:name] %></h3>
            <p style="font-size:13px;color:var(--text-muted);margin:0;line-height:1.5"><%= m[:desc] %></p>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <%# ─── Features Section ─── %>
  <section id="features" style="background:var(--bg-alt);padding:100px 24px;font-family:<%= body_font %>">
    <div style="max-width:1160px;margin:0 auto">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;margin-bottom:80px" class="stack-mobile">
        <div>
          <p style="font-family:<%= mono %>;font-size:11px;color:#c9a84c;letter-spacing:0.14em;text-transform:uppercase;margin-bottom:16px">Platform Features</p>
          <h2 style="font-family:<%= display %>;font-size:clamp(28px,4vw,44px);font-weight:700;color:var(--text);margin:0 0 20px;letter-spacing:-0.03em;line-height:1.1">Everything you need to run a modern business</h2>
          <p style="font-size:16px;color:var(--text-muted);line-height:1.8;margin:0 0 32px">SmartPay is more than a payment processor. It's a complete financial toolkit designed for how Gambian businesses actually work.</p>
        </div>

        <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:20px;padding:24px">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px">
            <span style="font-family:<%= display %>;font-size:13px;color:var(--text);font-weight:600">Revenue</span>
            <span style="font-family:<%= mono %>;font-size:10px;color:var(--text-faint);letter-spacing:0.06em">NOV 2024</span>
          </div>
          <p style="font-family:<%= display %>;font-size:36px;font-weight:700;color:#c9a84c;margin:0 0 4px;letter-spacing:-0.04em">D142,800</p>
          <p style="font-size:12px;color:var(--text-muted);font-family:<%= mono %>;margin:0 0 24px">↑ 18.4% from last month</p>
          <div style="display:flex;gap:6px;align-items:flex-end;height:60px;margin-bottom:20px">
            <% [40,65,45,80,55,90,70,100,75,88,60,95].each_with_index do |h,i| %>
              <div style="flex:1;background:<%= i == 11 ? '#c9a84c' : "rgba(201,168,76,#{0.15 + h/400.0})" %>;border-radius:3px 3px 0 0;height:<%= h %>%"></div>
            <% end %>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px">
            <% [{label:"Wave",val:"D64k",color:"#1a9bdc"},{label:"Visa",val:"D38k",color:"#1a1f71"},{label:"Afrimoney",val:"D40k",color:"#f97316"}].each do |item| %>
              <div style="background:var(--input-bg);border-radius:8px;padding:10px 12px">
                <div style="width:6px;height:6px;border-radius:50%;background:<%= item[:color] %>;margin-bottom:6px"></div>
                <p style="font-family:<%= mono %>;font-size:13px;color:var(--text);font-weight:500;margin:0 0 2px"><%= item[:val] %></p>
                <p style="font-family:<%= mono %>;font-size:9px;color:var(--text-faint);margin:0;letter-spacing:0.06em"><%= item[:label] %></p>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:1px;background:var(--input-bg);border:1px solid rgba(255,255,255,0.06);border-radius:16px;overflow:hidden">
        <% [
          {title:"Local & International",body:"Accept payments in GMD and major currencies. Serve customers in Gambia and across the globe without juggling multiple accounts.", icon:"globe"},
          {title:"Instant Settlement",body:"Money moves fast. Get paid in real time with automatic reconciliation and instant notifications straight to your phone.", icon:"zap"},
          {title:"Bank-Grade Security",body:"Every transaction is encrypted end-to-end. PCI-DSS compliant infrastructure protects your business and your customers.", icon:"shield"},
          {title:"Smart Invoicing",body:"Generate professional invoices in seconds. Attach payment links and let customers pay directly — no back-and-forth.", icon:"file"},
          {title:"Real-Time Analytics",body:"Live dashboards show exactly where your money is. Track revenue by channel, method, and time period.", icon:"chart"},
          {title:"Automated Reconciliation",body:"No more spreadsheets. SmartPay matches every incoming payment to the right invoice automatically.", icon:"sync"}
        ].each do |f| %>
          <div style="background:var(--bg-alt);padding:32px">
            <div style="width:40px;height:40px;border-radius:10px;background:rgba(201,168,76,0.1);border:1px solid rgba(201,168,76,0.2);display:flex;align-items:center;justify-content:center;margin-bottom:16px">
              <%= feature_icon(f[:icon]) %>
            </div>
            <h3 style="font-family:<%= display %>;font-size:15px;font-weight:600;color:var(--text);margin:0 0 10px;letter-spacing:-0.02em"><%= f[:title] %></h3>
            <p style="font-size:13px;color:var(--text-muted);margin:0;line-height:1.7"><%= f[:body] %></p>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <%# ─── How It Works ─── %>
  <section style="background:var(--hero-bg);padding:100px 24px;font-family:<%= body_font %>">
    <div style="max-width:900px;margin:0 auto;text-align:center">
      <p style="font-family:<%= mono %>;font-size:11px;color:#c9a84c;letter-spacing:0.14em;text-transform:uppercase;margin-bottom:16px">How It Works</p>
      <h2 style="font-family:<%= display %>;font-size:clamp(28px,4vw,44px);font-weight:700;color:var(--text);margin:0 0 60px;letter-spacing:-0.03em">Three steps to your first payment</h2>

      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px" class="stack-mobile">
        <% [
          {num:"01",title:"Create your account",body:"Sign up in under 3 minutes. Verify your business and connect your preferred payout method — mobile money or bank."},
          {num:"02",title:"Issue an invoice or payment link",body:"Build a professional invoice or share a simple payment link. Supports GMD, USD, EUR, and GBP."},
          {num:"03",title:"Get paid — your way",body:"Customers pay via Wave, Afrimoney, QMoney, Visa, or APS. Funds hit your account instantly."}
        ].each_with_index do |s,i| %>
          <div style="text-align:center">
            <div style="width:64px;height:64px;border-radius:50%;background:<%= i == 1 ? '#c9a84c' : 'rgba(201,168,76,0.1)' %>;border:2px solid <%= i == 1 ? '#c9a84c' : 'rgba(201,168,76,0.3)' %>;display:flex;align-items:center;justify-content:center;margin:0 auto 24px;<%= 'box-shadow:0 0 32px rgba(201,168,76,0.4)' if i == 1 %>">
              <span style="font-family:<%= mono %>;font-size:16px;font-weight:600;color:<%= i == 1 ? '#fff' : '#c9a84c' %>"><%= s[:num] %></span>
            </div>
            <h3 style="font-family:<%= display %>;font-size:16px;font-weight:600;color:var(--text);margin:0 0 12px;letter-spacing:-0.02em"><%= s[:title] %></h3>
            <p style="font-size:13px;color:var(--text-muted);margin:0;line-height:1.7"><%= s[:body] %></p>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <%# ─── For Who ─── %>
  <section id="for-who" style="background:var(--bg-alt);padding:100px 24px;font-family:<%= body_font %>">
    <div style="max-width:1160px;margin:0 auto">
      <div style="text-align:center;margin-bottom:60px">
        <p style="font-family:<%= mono %>;font-size:11px;color:#c9a84c;letter-spacing:0.14em;text-transform:uppercase;margin-bottom:16px">Who It's For</p>
        <h2 style="font-family:<%= display %>;font-size:clamp(28px,4vw,44px);font-weight:700;color:var(--text);margin:0;letter-spacing:-0.03em">Built for every Gambian business</h2>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:20px">
        <% [
          {title:"Small Businesses",subtitle:"Shops, restaurants, markets",body:"Sell to walk-in customers, WhatsApp orders, and online shoppers with the same payment link. Track every sale, every day.",items:["QR code payments at point of sale","WhatsApp payment links","Daily cash-out to mobile money"],color:"#f97316"},
          {title:"Freelancers",subtitle:"Designers, developers, consultants",body:"Invoice foreign clients in their currency, get paid in yours. SmartPay handles the FX and settles straight to your wallet.",items:["Multi-currency invoicing","Automatic FX conversion","Client portal for online payment"],color:"#c9a84c"},
          {title:"Enterprises",subtitle:"Importers, exporters, NGOs",body:"High-volume, multi-user payment operations with API access, bulk invoicing, and a dedicated account manager.",items:["REST API integration","Multi-user team access","Custom reconciliation reports"],color:"#818cf8"}
        ].each do |seg| %>
          <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:20px;padding:36px 32px">
            <div style="width:48px;height:48px;border-radius:14px;background:<%= seg[:color] %>18;border:1px solid <%= seg[:color] %>33;display:flex;align-items:center;justify-content:center;margin-bottom:24px">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="<%= seg[:color] %>" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
            </div>
            <p style="font-family:<%= mono %>;font-size:10px;color:<%= seg[:color] %>;letter-spacing:0.1em;text-transform:uppercase;margin:0 0 8px"><%= seg[:subtitle] %></p>
            <h3 style="font-family:<%= display %>;font-size:20px;font-weight:700;color:var(--text);margin:0 0 16px;letter-spacing:-0.03em"><%= seg[:title] %></h3>
            <p style="font-size:14px;color:var(--text-muted);margin:0 0 24px;line-height:1.7"><%= seg[:body] %></p>
            <% seg[:items].each do |item| %>
              <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="<%= seg[:color] %>" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                <span style="font-size:13px;color:var(--text-dim)"><%= item %></span>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <%# ─── Testimonials ─── %>
  <section style="background:var(--hero-bg);padding:100px 24px;font-family:<%= body_font %>">
    <div style="max-width:1160px;margin:0 auto">
      <div style="text-align:center;margin-bottom:60px">
        <p style="font-family:<%= mono %>;font-size:11px;color:#c9a84c;letter-spacing:0.14em;text-transform:uppercase;margin-bottom:16px">Testimonials</p>
        <h2 style="font-family:<%= display %>;font-size:clamp(28px,4vw,44px);font-weight:700;color:var(--text);margin:0;letter-spacing:-0.03em">Trusted by Gambian businesses</h2>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:20px">
        <% [
          {name:"Fatoumata Jallow",role:"Owner, Banjul Fabrics Co.",text:"SmartPay changed how I collect payments. My international buyers use Visa, my local customers use Wave — it all comes into one dashboard. Game changer."},
          {name:"Omar Ceesay",role:"Freelance Web Developer, Serrekunda",text:"I invoice clients in the UK and get paid in euros. SmartPay converts and settles to my Afrimoney in minutes. No more chasing payments."},
          {name:"Isatou Drammeh",role:"Director, Drammeh Trading Ltd",text:"We process over 200 transactions a month. The automated reconciliation alone saves my accountant two full days of work. Worth every dalasi."}
        ].each do |t| %>
          <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:20px;padding:32px">
            <div style="display:flex;gap:3px;margin-bottom:20px">
              <% 5.times do %>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="#c9a84c" stroke="#c9a84c" stroke-width="1"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              <% end %>
            </div>
            <p style="font-size:14px;color:rgba(255,255,255,0.65);line-height:1.8;margin:0 0 24px;font-style:italic">"<%= t[:text] %>"</p>
            <div style="display:flex;align-items:center;gap:12px">
              <div style="width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,#c9a84c33,#b8943a22);border:1px solid rgba(201,168,76,0.2);display:flex;align-items:center;justify-content:center;font-family:<%= display %>;font-size:13px;font-weight:700;color:#c9a84c"><%= t[:name].split.map {|n| n[0]}.join %></div>
              <div>
                <p style="font-size:13px;font-weight:600;color:var(--text);margin:0 0 2px"><%= t[:name] %></p>
                <p style="font-size:11px;color:var(--text-soft);margin:0;font-family:<%= mono %>"><%= t[:role] %></p>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <%# ─── Pricing ─── %>
  <section id="pricing" style="background:var(--bg-alt);padding:100px 24px;font-family:<%= body_font %>">
    <div style="max-width:1100px;margin:0 auto">
      <div style="text-align:center;margin-bottom:60px">
        <p style="font-family:<%= mono %>;font-size:11px;color:#c9a84c;letter-spacing:0.14em;text-transform:uppercase;margin-bottom:16px">Pricing</p>
        <h2 style="font-family:<%= display %>;font-size:clamp(28px,4vw,44px);font-weight:700;color:var(--text);margin:0 0 16px;letter-spacing:-0.03em">Simple, transparent pricing</h2>
        <p style="font-size:16px;color:var(--text-muted);margin:0">Priced in Gambian Dalasi. No hidden charges.</p>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:20px">
        <% [
          {name:"Starter",price:"Free",sub:"0% platform fee",desc:"Perfect for freelancers and solo operators just getting started.",features:["Up to 50 invoices/month","Wave + Afrimoney","Basic analytics","Payment links","Email support"],cta:"Start free",highlight:false},
          {name:"Growth",price:"D850",sub:"/month · 0.8% transaction fee",desc:"For small businesses ready to scale with multi-channel payments.",features:["Unlimited invoices","All 5 payment methods","Advanced analytics","Auto-reconciliation","Priority support","Custom invoice branding"],cta:"Start 14-day trial",highlight:true},
          {name:"Business",price:"D2,400",sub:"/month · 0.5% transaction fee",desc:"For established businesses and teams with high transaction volumes.",features:["Everything in Growth","Multi-user access","API access","Bulk invoicing","Dedicated account manager","SLA guarantee"],cta:"Talk to sales",highlight:false}
        ].each do |plan| %>
          <div style="background:<%= plan[:highlight] ? 'var(--pricing-highlight-bg)' : 'var(--bg-card)' %>;border:<%= plan[:highlight] ? '1px solid rgba(201,168,76,0.35)' : '1px solid var(--border)' %>;border-radius:20px;padding:36px 32px;position:relative;<%= 'box-shadow:0 0 60px rgba(201,168,76,0.08)' if plan[:highlight] %>">
            <% if plan[:highlight] %>
              <div style="position:absolute;top:-12px;left:50%;transform:translateX(-50%);background:#c9a84c;color:#fff;font-size:10px;font-family:<%= mono %>;letter-spacing:0.1em;text-transform:uppercase;padding:4px 14px;border-radius:100px;font-weight:600">Most popular</div>
            <% end %>
            <p style="font-family:<%= display %>;font-size:13px;font-weight:600;color:<%= plan[:highlight] ? '#c9a84c' : 'rgba(255,255,255,0.5)' %>;letter-spacing:0.04em;margin:0 0 16px"><%= plan[:name].upcase %></p>
            <p style="font-family:<%= display %>;font-size:38px;font-weight:800;color:var(--text);margin:0 0 4px;letter-spacing:-0.04em"><%= plan[:price] %></p>
            <p style="font-family:<%= mono %>;font-size:11px;color:var(--text-soft);margin:0 0 16px;letter-spacing:0.04em"><%= plan[:sub] %></p>
            <p style="font-size:13px;color:var(--text-muted);margin:0 0 28px;line-height:1.6"><%= plan[:desc] %></p>
            <div style="display:flex;flex-direction:column;gap:10px;margin-bottom:32px">
              <% plan[:features].each do |f| %>
                <div style="display:flex;align-items:center;gap:10px">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="<%= plan[:highlight] ? '#c9a84c' : 'rgba(255,255,255,0.3)' %>" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                  <span style="font-size:13px;color:var(--text-dim)"><%= f %></span>
                </div>
              <% end %>
            </div>
            <%= link_to new_user_registration_path, style: "display:flex;align-items:center;justify-content:center;gap:6px;background:#{plan[:highlight] ? '#c9a84c' : 'rgba(255,255,255,0.07)'};color:#{plan[:highlight] ? '#fff' : 'rgba(255,255,255,0.7)'};text-decoration:none;padding:12px;border-radius:10px;font-size:14px;font-weight:600;font-family:#{body_font}" do %>
              <%= plan[:cta] %>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <%# ─── Trust / Security ─── %>
  <section style="background:var(--hero-bg);padding:100px 24px;font-family:<%= body_font %>">
    <div style="max-width:1160px;margin:0 auto">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center" class="stack-mobile">
        <div>
          <p style="font-family:<%= mono %>;font-size:11px;color:#c9a84c;letter-spacing:0.14em;text-transform:uppercase;margin-bottom:16px">Security</p>
          <h2 style="font-family:<%= display %>;font-size:clamp(26px,3.5vw,40px);font-weight:700;color:var(--text);margin:0 0 20px;letter-spacing:-0.03em;line-height:1.15">Your money. Protected at every step.</h2>
          <p style="font-size:15px;color:var(--text-muted);line-height:1.8;margin:0 0 36px">SmartPay was built with security as a first principle — not an afterthought. Every transaction is authenticated, encrypted, and monitored in real time.</p>
          <div style="display:flex;gap:16px;flex-wrap:wrap">
            <% ["Central Bank Compliant","Licensed Operator","99.97% Uptime SLA"].each do |badge| %>
              <div style="display:flex;align-items:center;gap:6px;background:rgba(201,168,76,0.08);border:1px solid rgba(201,168,76,0.2);border-radius:6px;padding:6px 12px">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#c9a84c" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                <span style="font-size:11px;font-family:<%= mono %>;color:#c9a84c;letter-spacing:0.06em"><%= badge %></span>
              </div>
            <% end %>
          </div>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
          <% [{title:"256-bit TLS Encryption",body:"All data in transit is protected by industry-standard encryption."},{title:"PCI-DSS Compliant",body:"We meet the highest card payment security standards globally."},{title:"2FA on every account",body:"Two-factor authentication protects every login and payout."},{title:"Fraud monitoring",body:"Real-time anomaly detection flags suspicious transactions instantly."}].each do |item| %>
            <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:14px;padding:24px 20px">
              <div style="width:36px;height:36px;border-radius:9px;background:rgba(201,168,76,0.1);border:1px solid rgba(201,168,76,0.2);display:flex;align-items:center;justify-content:center;margin-bottom:14px">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#c9a84c" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              </div>
              <h4 style="font-family:<%= display %>;font-size:13px;font-weight:600;color:var(--text);margin:0 0 8px;letter-spacing:-0.01em"><%= item[:title] %></h4>
              <p style="font-size:12px;color:var(--text-muted);margin:0;line-height:1.6"><%= item[:body] %></p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </section>

  <%# ─── CTA Banner ─── %>
  <section style="background:var(--hero-bg);padding:0 24px 100px;font-family:<%= body_font %>">
    <div style="max-width:900px;margin:0 auto">
      <div style="background:var(--cta-bg);border:1px solid rgba(201,168,76,0.2);border-radius:24px;padding:64px 56px;text-align:center;position:relative;overflow:hidden;box-shadow:0 0 80px rgba(201,168,76,0.06)">
        <div style="position:absolute;top:0;left:50%;transform:translateX(-50%);width:400px;height:200px;background:radial-gradient(ellipse, rgba(201,168,76,0.15) 0%, transparent 70%);pointer-events:none"></div>
        <div style="position:relative">
          <p style="font-family:<%= mono %>;font-size:11px;color:#c9a84c;letter-spacing:0.14em;text-transform:uppercase;margin-bottom:20px">Start Today</p>
          <h2 style="font-family:<%= display %>;font-size:clamp(28px,4vw,48px);font-weight:800;color:var(--text);margin:0 0 16px;letter-spacing:-0.04em">Ready to get paid smartly?</h2>
          <p style="font-size:16px;color:var(--text-muted);margin:0 0 40px;line-height:1.7;max-width:480px;margin-left:auto;margin-right:auto">Join thousands of Gambian businesses already using SmartPay. Set up your account in 3 minutes — no paperwork, no waiting.</p>
          <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
            <%= link_to new_user_registration_path, style: "display:flex;align-items:center;gap:8px;background:#c9a84c;color:#0d0f14;text-decoration:none;padding:14px 32px;border-radius:10px;font-size:15px;font-weight:700;font-family:#{body_font};box-shadow:0 0 40px rgba(201,168,76,0.35)" do %>
              Create free account
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            <% end %>
            <a href="mailto:hello@smartpay.gm" style="display:flex;align-items:center;gap:8px;background:transparent;border:1px solid var(--border);color:var(--text-dim);text-decoration:none;padding:14px 28px;border-radius:10px;font-size:15px;font-weight:500;font-family:<%= body_font %>">Contact sales</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%# ─── Footer ─── %>
  <footer style="background:var(--bg-footer);border-top:1px solid var(--border-light);padding:64px 24px 32px;font-family:<%= body_font %>">
    <div style="max-width:1160px;margin:0 auto">
      <div style="display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:40px;margin-bottom:56px" class="stack-mobile">
        <div>
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:16px">
             <%= image_tag "smart-pay-logo.png", alt: "SmartPay", class: "logo-dark h-[120px] w-auto" %>
             <%= image_tag "smart-logo-light.png", alt: "SmartPay", class: "logo-light h-[120px] w-auto" %>
          </div>
          <p style="font-size:13px;color:var(--text-soft);line-height:1.8;max-width:280px;margin:0 0 20px">The smart payment platform built for Gambian businesses. Accept any payment, anywhere.</p>
          <p style="font-family:<%= mono %>;font-size:11px;color:var(--text-faint);letter-spacing:0.06em">© <%= Date.current.year %> SmartPay Ltd · Banjul, The Gambia</p>
        </div>

        <% [
          {heading:"Product",links:["Features","Pricing","Security","API Docs"]},
          {heading:"Company",links:["About Us","Blog","Careers","Contact"]},
          {heading:"Support",links:["Help Center","WhatsApp Support","System Status","Privacy Policy"]}
        ].each do |col| %>
          <div>
            <p style="font-family:<%= mono %>;font-size:18px;color:var(--text-faint);letter-spacing:0.12em;text-transform:uppercase;margin-bottom:16px"><%= col[:heading] %></p>
            <div style="display:flex;flex-direction:column;gap:10px">
              <% col[:links].each do |l| %>
                <a href="#" style="font-size:13px;color:var(--text-muted);text-decoration:none"><%= l %></a>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </footer>
</div>

<style>
  @media (max-width:768px) {
    .stack-mobile { grid-template-columns:1fr !important; gap:40px !important; }
  }
</style>
