<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "SmartPay" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="CreativesHub">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,300;1,9..144,400&family=DM+Sans:wght@300;400;500;600&family=Geist+Mono:wght@300;400;500&display=swap" rel="stylesheet">
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-background text-foreground" style="font-family: var(--font-body)">
    <% if user_signed_in? && current_account.present? %>
      <div data-controller="sidebar" class="flex h-screen overflow-hidden">
        <div data-sidebar-target="backdrop" class="hidden fixed inset-0 bg-black/60 z-40 lg:hidden" data-action="click->sidebar#close"></div>

        <%= render "shared/sidebar" %>

        <main class="flex-1 overflow-y-auto scrollbar-hide">
          <div class="lg:hidden sticky top-0 z-20 flex items-center justify-between px-4 py-3 bg-background/80 backdrop-blur border-b border-border">
            <button type="button" data-action="sidebar#open" class="p-1 -ml-1 text-foreground">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
            </button>
            <div class="flex items-center gap-2">
              <div class="w-6 h-6 rounded bg-primary flex items-center justify-center">
                <svg class="w-3.5 h-3.5 text-primary-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                  <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
                  <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
                </svg>
              </div>
              <span class="text-sm font-medium text-foreground" style="font-family: var(--font-display)">SmartPay</span>
            </div>
            <div class="w-9"></div>
          </div>
          <%= yield %>
        </main>
      </div>
    <% else %>
      <main>
        <% if flash[:notice] %>
          <div class="fixed top-4 right-4 z-50 max-w-sm rounded-md bg-accent/20 border border-accent/30 px-4 py-3 text-sm text-foreground">
            <%= flash[:notice] %>
          </div>
        <% end %>
        <% if flash[:alert] %>
          <div class="fixed top-4 right-4 z-50 max-w-sm rounded-md bg-destructive/20 border border-destructive/30 px-4 py-3 text-sm text-foreground">
            <%= flash[:alert] %>
          </div>
        <% end %>
        <%= yield %>
      </main>
    <% end %>
  </body>
</html>
