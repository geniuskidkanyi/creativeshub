<!DOCTYPE html>
<html data-controller="theme" data-theme="dark">
  <head>
    <title>SmartPay — Get Paid Smartly</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="The payment platform built for Gambian businesses and freelancers. Accept Wave, Visa, Afrimoney, QMoney, and APS.">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="SmartPay">
    <meta name="theme-color" content="#0a0e18" media="(prefers-color-scheme: dark)">
    <meta name="theme-color" content="#f8fafe" media="(prefers-color-scheme: light)">
    <meta name="mobile-web-app-capable" content="yes">
    <link rel="manifest" href="/manifest.json">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <%= csrf_meta_tags %>
    <%= render "shared/google_analytics" %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&family=Hanken+Grotesk:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }

      :root,
      [data-theme="dark"] {
        --bg: #0a0e18;
        --bg-alt: #0f1421;
        --bg-card: #12172a;
        --bg-footer: #080b13;
        --text: #fff;
        --text-muted: rgba(255,255,255,0.45);
        --text-dim: rgba(255,255,255,0.55);
        --text-soft: rgba(255,255,255,0.35);
        --text-faint: rgba(255,255,255,0.2);
        --border: rgba(255,255,255,0.07);
        --border-light: rgba(255,255,255,0.06);
        --nav-bg: rgba(10,14,24,0.92);
        --nav-border: rgba(255,255,255,0.06);
        --nav-link: rgba(255,255,255,0.6);
        --primary: #709afb;
        --primary-dark: #5c84e3;
        --primary-ink: #091123;
        --primary-rgb: 112,154,251;
        --accent: #ed8d7d;
        --primary-glow: rgba(112,154,251,0.15);
        --stats-text: rgba(255,255,255,0.4);
        --badge-bg: rgba(112,154,251,0.1);
        --badge-border: rgba(112,154,251,0.25);
        --card-hover-border: rgba(255,255,255,0.07);
        --gradient-glow: radial-gradient(ellipse, rgba(112,154,251,0.12) 0%, transparent 70%);
        --grid-color: rgba(112,154,251,0.04);
        --pricing-highlight-bg: linear-gradient(160deg, #101731 0%, #0e142b 100%);
        --cta-bg: linear-gradient(135deg, #101731 0%, #121a38 50%, #101731 100%);
        --hero-bg: #0a0e18;
        --input-bg: rgba(255,255,255,0.06);
        --feature-grid-bg: rgba(255,255,255,0.06);
      }

      [data-theme="light"] {
        --bg: #f8fafe;
        --bg-alt: #eef2fa;
        --bg-card: #ffffff;
        --bg-footer: #f2f5fc;
        --text: #141a29;
        --text-muted: rgba(20,26,41,0.5);
        --text-dim: rgba(20,26,41,0.6);
        --text-soft: rgba(20,26,41,0.4);
        --text-faint: rgb(30 38 58 / 71%);
        --border: rgba(20,26,41,0.08);
        --border-light: rgba(20,26,41,0.05);
        --nav-bg: rgba(248,250,254,0.92);
        --nav-border: rgba(20,26,41,0.08);
        --nav-link: rgba(20,26,41,0.6);
        --primary: #355bbd;
        --primary-dark: #2549a9;
        --primary-ink: #ffffff;
        --primary-rgb: 53,91,189;
        --accent: #c25d58;
        --primary-glow: rgba(53,91,189,0.1);
        --stats-text: rgba(20,26,41,0.55);
        --badge-bg: rgba(53,91,189,0.08);
        --badge-border: rgba(53,91,189,0.3);
        --card-hover-border: rgba(20,26,41,0.12);
        --gradient-glow: radial-gradient(ellipse, rgba(53,91,189,0.08) 0%, transparent 70%);
        --grid-color: rgba(53,91,189,0.03);
        --pricing-highlight-bg: linear-gradient(160deg, #f0f4fe 0%, #e8eefc 100%);
        --cta-bg: linear-gradient(135deg, #f0f4fe 0%, #e8eefc 50%, #f0f4fe 100%);
        --hero-bg: #f8fafe;
        --input-bg: rgba(20,26,41,0.04);
        --feature-grid-bg: rgba(20,26,41,0.05);
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-size: 15px;
        -webkit-font-smoothing: antialiased;
      }

      .logo-dark { display: none; }
      .logo-light { display: none; }
      [data-theme="dark"] .logo-dark { display: block; }
      [data-theme="light"] .logo-light { display: block; }
    </style>
    <%# Layout marker: forces Turbo to full-reload when a visit crosses into a
        page using a different layout (they have incompatible heads). %>
    <meta name="app-layout" content="landing" data-turbo-track="reload">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <div data-controller="site-flash"
         data-site-flash-notice-value="<%= flash[:notice].presence %>"
         data-site-flash-alert-value="<%= flash[:alert].presence %>">
    </div>
    <%= yield %>
  </body>
</html>
